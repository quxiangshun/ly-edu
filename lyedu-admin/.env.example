# 复制为 .env.development 或 .env.production 使用
# 开发环境：npm run dev 时加载 .env.development
# 生产环境：npm run build 时加载 .env.production

# 应用标题
VITE_APP_TITLE=LyEdu 管理后台

# 开发：API 代理目标（vite 将 /api 转发到此地址）
VITE_API_PROXY_TARGET=http://localhost:9700

# 生产：API 基础路径（同域部署用 /api，跨域时填完整地址如 https://api.example.com）
VITE_API_BASE=/api
