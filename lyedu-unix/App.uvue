<script lang="uts">
	import { isLoggedIn } from './utils/auth'
	import { initTheme } from './utils/theme'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	function checkAuthAndRedirect(): void {
		if (isLoggedIn()) return
		const pages = getCurrentPages()
		const cur = pages.length > 0 ? (pages[pages.length - 1] as any) : null
		const route = cur != null ? (cur.route ?? '') : ''
		if (route === 'pages/login/login') return
		uni.reLaunch({ url: '/pages/login/login' })
	}

	export default {
		onLaunch() {
			initTheme()
			checkAuthAndRedirect()
		},
		onShow() {
			checkAuthAndRedirect()
		},
		onHide() {
			console.log('App Hide')
		},
		// #ifdef APP-ANDROID || APP-HARMONY
		onLastPageBackPress() {
			console.log('App LastPageBackPress')
			if (firstBackTime == 0) {
				uni.showToast({
					title: '再按一次退出应用',
					position: 'bottom',
				})
				firstBackTime = Date.now()
				setTimeout(() => {
					firstBackTime = 0
				}, 2000)
			} else if (Date.now() - firstBackTime < 2000) {
				firstBackTime = Date.now()
				uni.exit()
			}
		},
		// #endif
		onExit() {
			console.log('App Exit')
		},
	}
</script>

<style>
	/* 每个页面公共样式；默认主题色与后台一致，各页根节点可 :style 覆盖 --brand-primary、--brand-bg 等 */
	.page {
		--brand-primary: #409eff;
		--brand-bg: rgba(64,158,255,0.06);
		--brand-bg-strong: rgba(64,158,255,0.12);
		/* 自定义 tabBar 高度，供含 tabBar 的页面设置 padding-bottom */
		--tab-bar-height: 50px;
	}

	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}

	/* 全局：主色按钮、链接等统一使用主题色 */
	.primary-btn {
		background-color: var(--brand-primary);
		color: #ffffff;
		border-radius: 24px;
		padding: 10px 24px;
		font-size: 15px;
	}
</style>