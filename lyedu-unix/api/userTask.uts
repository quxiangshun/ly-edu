import { get, post } from '../utils/request'
import type { Task } from './task'

export type UserTask = {
	id: number
	userId: number
	taskId: number
	progress?: string
	status: number
	completedAt?: string
	createTime?: string
	updateTime?: string
}

export type TaskWithUserProgress = {
	task: Task
	userTask: UserTask | null
}

export function getMyTasks(): Promise<TaskWithUserProgress[]> {
	return get<TaskWithUserProgress[]>('/user-task/my')
}

/** 获取任务详情（闯关项在 task.items JSON 中） */
export function getTaskDetail(taskId: number): Promise<Task> {
	return get<Task>('/user-task/task/' + taskId)
}

/** 获取或创建任务进度 */
export function getOrCreateProgress(taskId: number): Promise<UserTask> {
	return get<UserTask>('/user-task/task/' + taskId + '/progress')
}

/** 同步任务进度（progress 为 JSON 字符串，如 {"items":[{"type":"course","id":1,"done":1}]}） */
export function updateProgress(taskId: number, progress: string): Promise<UserTask> {
	return post<UserTask>('/user-task/task/' + taskId + '/progress', { progress: progress })
}
