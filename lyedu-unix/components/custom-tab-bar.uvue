<template>
	<view class="custom-tab-bar">
		<view class="tab-bar-content">
			<view 
				v-for="(item, index) in tabList" 
				:key="index"
				class="tab-item"
				:class="{ active: currentIndex === index }"
				@click="handleTabClick(index, item.pagePath)"
			>
				<view class="tab-icon">
					<image 
						:src="currentIndex === index ? item.selectedIconPath : item.iconPath" 
						mode="aspectFit"
					>
					</image>
				</view>
				<view class="tab-indicator"></view>
				<text class="tab-text">{{ item.text }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'

	const props = defineProps<{
		current?: number
	}>()

	const emit = defineEmits<{
		change: [index: number]
	}>()

	const currentIndex = computed((): number => {
		const v = props.current ?? 0
		return v >= 0 && v < 3 ? v : 0
	})
	let switching = false
	const tabList = ref([
		{ pagePath: '/pages/index/index', text: '首页', iconPath: '/static/icons/tabbar/tab-home.png', selectedIconPath: '/static/icons/tabbar/tab-home-active.png' },
		{ pagePath: '/pages/exam-list/exam-list', text: '考试', iconPath: '/static/icons/tabbar/tab-exam.png', selectedIconPath: '/static/icons/tabbar/tab-exam.png' },
		{ pagePath: '/pages/my/my', text: '我的', iconPath: '/static/icons/tabbar/tab-my.png', selectedIconPath: '/static/icons/tabbar/tab-my-active.png' }
	])

	function handleTabClick(index: number, pagePath: string): void {
		if (currentIndex.value === index) return
		if (switching) return
		switching = true
		emit('change', index)
		uni.switchTab({
			url: pagePath,
			complete: () => {
				setTimeout(() => {
					switching = false
				}, 300)
			}
		})
	}
</script>

<style scoped>
	/* 底部固定，与原生 tabBar 行为一致；预留安全区域避免与刘海/Home 指示条重叠 */
	.custom-tab-bar {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		width: 100%;
		min-height: 50px;
		padding-bottom: constant(safe-area-inset-bottom);
		padding-bottom: env(safe-area-inset-bottom);
	background-color: rgba(255,255,255,0.95);
	border-top-width: 1px;
	border-top-color: rgba(0,0,0,0.06);
		border-top-style: solid;
		z-index: 999;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
	}

	.tab-bar-content {
		display: flex;
		flex-direction: row;
		flex: 1;
		min-height: 50px;
	}

	.tab-item {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 6px 0;
		flex-shrink: 0;
	}

	.tab-icon {
		width: 24px;
		height: 24px;
		margin-bottom: 4px;
		flex-shrink: 0;
	}

	.tab-icon image {
		width: 100%;
		height: 100%;
	}

	.tab-text {
		font-size: 11px;
		color: #969799;
	}

	.tab-indicator {
		width: 20px;
		height: 3px;
		border-radius: 2px;
		margin-top: 2px;
		background-color: transparent;
	}

	.tab-item.active .tab-text {
		color: var(--brand-primary);
	}

	.tab-item.active .tab-indicator {
		background-color: var(--brand-primary);
	}
</style>