<template>
	<view class="page" :style="themeRootStyle">
		<scroll-view scroll-y="true" style="flex:1">
			<view class="content">
				<view v-if="loading" class="loading-wrap">
					<text class="loading-text">加载中...</text>
				</view>
				<template v-else>
					<view v-for="course in courseList" :key="course.id" class="course-card" @click="navToDetail(course)">
						<image class="course-cover" :src="coverUrl(course.cover)" mode="aspectFill"></image>
						<view class="course-body">
							<text class="course-title">{{ course.title }}</text>
							<text class="course-desc">{{ course.description != null ? course.description : '暂无描述' }}</text>
							<view class="card-footer">
								<text v-if="course.status === 1" class="status-tag">上架</text>
								<button class="start-btn" size="mini" @click.stop="handleStartLearn(course)">开始学习</button>
							</view>
						</view>
					</view>
					<view v-if="courseList.length === 0" class="empty-wrap">
						<text class="empty-text">暂无课程</text>
					</view>
				</template>
			</view>
		</scroll-view>

	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { getCoursePage, type Course } from '../../api/course'
	import { joinCourse } from '../../api/learning'
	import { assetUrl } from '../../config/api'
	import { getThemeRootStyle } from '../../utils/theme'

	const themeRootStyle = computed(() => getThemeRootStyle())

	const loading = ref(false)
	const courseList = ref<Course[]>([])

	onShow(() => {
		loadCourses()
	})

	function coverUrl(cover: string | null | undefined): string {
		if (cover != null && cover.length > 0) {
			const u = assetUrl(cover)
			if (u.length > 0) return u
		}
		return '/static/logo.png'
	}

	async function loadCourses(): Promise<void> {
		loading.value = true
		try {
			const res = await getCoursePage({ page: 1, size: 20 })
			courseList.value = res != null && res.records != null ? res.records : []
		} catch (_e) {
			uni.showToast({ title: '加载课程失败', icon: 'none' })
			courseList.value = []
		} finally {
			loading.value = false
		}
	}

	function navToDetail(course: Course): void {
		uni.navigateTo({ url: '/pages/course-detail/course-detail?id=' + course.id })
	}

	async function handleStartLearn(course: Course): Promise<void> {
		if (!uni.getStorageSync('token')) {
			uni.showToast({ title: '请先登录', icon: 'none' })
			uni.navigateTo({ url: '/pages/login/login?redirect=' + encodeURIComponent('/pages/course-detail/course-detail?id=' + course.id) })
			return
		}
		try {
			await joinCourse(course.id)
			uni.showToast({ title: '已加入课程', icon: 'success' })
			uni.navigateTo({ url: '/pages/course-detail/course-detail?id=' + course.id })
		} catch (_e) {
			uni.showToast({ title: '加入课程失败', icon: 'none' })
		}
	}

</script>

<style>
.page {
	flex: 1;
	flex-direction: column;
	min-height: 100vh;
	background: var(--brand-gradient-immersive);
}
.content {
		padding: 16px 16px 80px 16px;
	}
.loading-wrap {
	padding: 40px 0;
	align-items: center;
}
.loading-text {
	font-size: 14px;
	color: #969799;
}
.course-card {
	flex-direction: column;
	margin-bottom: 16px;
	border-radius: 12px;
	overflow: hidden;
	background-color: #ffffff;
	border-width: 1px;
	border-color: rgba(0,0,0,0.04);
	border-style: solid;
}
.course-cover {
	width: 100%;
	height: 120px;
	background-color: #ebedf0;
}
.course-body {
	flex-direction: column;
	padding: 12px;
}
.course-title {
	font-size: 16px;
	font-weight: 600;
	color: #323233;
}
.course-desc {
	font-size: 13px;
	color: #646566;
	margin-top: 6px;
}
.card-footer {
	flex-direction: row;
	justify-content: flex-end;
	align-items: center;
	margin-top: 10px;
}
.status-tag {
	font-size: 12px;
	color: var(--brand-primary);
	margin-right: 12px;
}
.start-btn {
	background-color: var(--brand-primary);
	color: #ffffff;
	border-radius: 16px;
}
.empty-wrap {
	padding: 40px 0;
	align-items: center;
}
.empty-text {
	font-size: 14px;
	color: #969799;
}
</style>
