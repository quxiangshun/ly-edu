<template>
	<scroll-view class="page" scroll-y="true" style="flex:1" @scrolltolower="loadList">
		<view class="content">
			<text class="subtitle">可下载的文档与资料</text>
			<view v-for="item in knowledgeList" :key="item.id" class="item-row" @click="handleDownload(item)">
				<text class="item-title">{{ item.title }}</text>
				<text v-if="item.category != null" class="item-label">分类：{{ item.category }}</text>
			</view>
			<view v-if="!loading && knowledgeList.length === 0" class="empty-wrap">
				<text class="empty-text">暂无知识文档</text>
			</view>
			<view v-if="loading" class="loading-wrap">
				<text class="loading-text">加载中...</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getKnowledgePage, type Knowledge } from '../../api/knowledge'
	import { assetUrl } from '../../config/api'
	import { getDownloadFilePath, buildDownloadFileName } from '../../utils/file'
	// #ifdef H5
	import { downloadFileH5 } from '../../utils/file'
	// #endif

	const loading = ref(false)
	const knowledgeList = ref<Knowledge[]>([])
	const page = ref(1)
	const size = 20
	const finished = ref(false)

	onShow(() => {
		knowledgeList.value = []
		page.value = 1
		finished.value = false
		loadList()
	})

	async function loadList(): Promise<void> {
		if (finished.value || loading.value) return
		loading.value = true
		try {
			const res = await getKnowledgePage({ page: page.value, size: size })
			const list = res != null && res.records != null ? res.records : []
			if (list.length > 0) {
				for (let i = 0; i < list.length; i++) {
					knowledgeList.value.push(list[i])
				}
				page.value = page.value + 1
			}
			if (list.length < size) {
				finished.value = true
			}
		} catch (_e) {
			finished.value = true
			uni.showToast({ title: '加载失败', icon: 'none' })
		} finally {
			loading.value = false
		}
	}

	function handleDownload(row: Knowledge): void {
		if (row.fileUrl == null || row.fileUrl.length === 0) {
			uni.showToast({ title: '文件地址无效', icon: 'none' })
			return
		}
		const url = assetUrl(row.fileUrl)
		if (url.length === 0) {
			uni.showToast({ title: '文件地址无效', icon: 'none' })
			return
		}
		uni.showToast({ title: '正在打开' })
		const fileName = buildDownloadFileName(row.title, row.fileType, row.fileUrl)
		// #ifdef H5
		downloadFileH5(url, fileName, () => {
			uni.showToast({ title: '下载完成', icon: 'success' })
		})
		// #endif
		// #ifndef H5
		const customPath = getDownloadFilePath(row.title, row.fileType, row.fileUrl)
		if (customPath != null) {
			uni.downloadFile({
				url: url,
				filePath: customPath,
				success: (res) => {
					const path = res.filePath ?? res.tempFilePath
					if (res.statusCode === 200 && path != null && path.length > 0) {
						uni.openDocument({ filePath: path })
					}
				}
			})
		} else {
			uni.downloadFile({
				url: url,
				success: (res) => {
					const path = res.tempFilePath
					if (res.statusCode === 200 && path != null && path.length > 0) {
						uni.openDocument({ filePath: path })
					}
				}
			})
		}
		// #endif
	}
</script>

<style>
.page {
	flex: 1;
}
.content {
	flex-direction: column;
	padding: 16px;
}
.subtitle {
	font-size: 14px;
	color: #969799;
	margin-bottom: 12px;
}
.item-row {
	flex-direction: column;
	padding: 14px 0;
	border-bottom-width: 1px;
	border-bottom-color: #ebedf0;
}
.item-title {
	font-size: 16px;
	color: #323233;
}
.item-label {
	font-size: 12px;
	color: #969799;
	margin-top: 4px;
}
.empty-wrap {
	padding: 40px 0;
	align-items: center;
}
.empty-text {
	font-size: 14px;
	color: #969799;
}
.loading-wrap {
	padding: 16px 0;
	align-items: center;
}
.loading-text {
	font-size: 14px;
	color: #969799;
}
</style>
