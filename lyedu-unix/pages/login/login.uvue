<template>
	<view class="page" :style="themeRootStyle">
		<view class="logo-block logo-fixed">
			<image class="login-logo" :src="logoSrc" mode="aspectFit"></image>
			<text class="login-title">{{ siteTitle }}</text>
			<text class="login-subtitle">企业培训平台</text>
		</view>
		<view class="logo-spacer"></view>
		<scroll-view class="page-body" scroll-y="true" style="flex:1">
		<view class="content">
			<!-- 飞书/钉钉/企微 App 内：授权登录按钮 -->
			<view v-if="showAuthButton" class="auth-block">
				<button class="auth-btn" :loading="loading" @click="handleThirdPartyAuth">{{ authLabel }}授权登录</button>
			</view>

			<!-- 飞书/钉钉/企微 PC 或 浏览器：扫码登录 -->
			<view v-else-if="showQrcode && !(h5CanToggle && h5LoginMode === 'password')" class="qrcode-block">
				<text class="qrcode-hint">请使用{{ authLabel }}扫码登录</text>
				<image v-if="qrcodeUrl.length > 0" class="qrcode-img" :src="qrcodeUrl" mode="aspectFit"></image>
				<view v-else class="qrcode-loading">
					<text class="qrcode-loading-text">{{ qrcodeLoading ? '加载中...' : '暂无扫码登录' }}</text>
				</view>
				<text v-if="h5CanToggle" class="switch-link" @click="h5LoginMode = 'password'">账号密码登录</text>
			</view>

			<!-- 微信小程序：手机号登录（失败 1 次后自动切换为账号密码） -->
			<view v-show="showWechatPhone && !showPasswordForm" class="wechat-block">
				<text class="wechat-hint">请授权手机号以登录</text>
				<button open-type="getPhoneNumber" class="auth-btn" :loading="loading" @getphonenumber="handleWechatPhone">获取手机号登录</button>
			</view>

			<!-- 账号密码登录 -->
			<view v-show="showPasswordForm && (!h5CanToggle || h5LoginMode === 'password')" class="form-block">
				<text v-if="h5CanToggle" class="switch-link switch-link-top" @click="h5LoginMode = 'qrcode'">{{ authLabel }}扫码登录</text>
				<view class="field-row">
					<text class="field-label">手机号</text>
					<input class="field-input" v-model="username" placeholder="请输入手机号" adjust-position="false" />
				</view>
				<view class="field-row">
					<text class="field-label">密码</text>
					<input class="field-input" :type="showPassword ? 'text' : 'password'" v-model="password" placeholder="请输入密码" adjust-position="false" />
					<image class="eye-btn" :src="showPassword ? '/static/icons/iconify/ri--eye-close-line.svg' : '/static/icons/iconify/ri--eye-line.svg'" mode="aspectFit" @click="showPassword = !showPassword"></image>
				</view>
				<button class="submit-btn" :loading="loading" @click="handleLogin">登录</button>
			</view>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { login, getPlatformInfo, getFeishuAuthUrl, getFeishuQrcode, feishuCallback, wechatMpPhoneLogin } from '../../api/auth'
	import { getConfigByKey } from '../../api/config'
	import { setToken, setUser } from '../../utils/auth'
	import { getThemeRootStyle } from '../../utils/theme'
	import { getRunPlatform, needQrcodeLogin, isWechatMp } from '../../utils/platform'

	const themeRootStyle = computed(() => getThemeRootStyle())

	const siteTitle = ref('LyEdu')
	const siteLogo = ref('')
	const logoSrc = computed(() => {
		const raw = siteLogo.value.length > 0 ? siteLogo.value : '/static/logo.png'
		return raw.startsWith('http') ? raw : raw
	})

	const username = ref('')
	const password = ref('')
	const showPassword = ref(false)
	const loading = ref(false)
	const authLabel = ref('企业')
	const platformInfo = ref<{ platform: string; authLabel: string } | null>(null)
	const runPlatform = ref('unknown')
	const qrcodeUrl = ref('')
	const qrcodeLoading = ref(false)
	const wxLoginCode = ref('')
	const h5LoginMode = ref<'qrcode' | 'password'>('qrcode')

	const h5CanToggle = computed((): boolean => {
		return runPlatform.value === 'h5' && showQrcode.value && showPasswordForm.value
	})

	const showAuthButton = computed((): boolean => {
		if (platformInfo.value == null) return false
		const p = platformInfo.value.platform
		if (p === 'local') return false
		if (runPlatform.value === 'feishu_app') return (p === 'feishu' || p === 'dingtalk' || p === 'wecom')
		return false
	})

	const showQrcode = computed((): boolean => {
		if (platformInfo.value == null) return false
		const p = platformInfo.value.platform
		if (p === 'local') return false
		return needQrcodeLogin() && (p === 'feishu' || p === 'dingtalk' || p === 'wecom')
	})

	const showWechatPhone = computed((): boolean => {
		return isWechatMp()
	})

	const wechatPhoneFailCount = ref(0)
	const showPasswordForm = computed((): boolean => {
		if (platformInfo.value == null) return true
		const p = platformInfo.value.platform
		if (p === 'local') return true
		if (p === 'wechat_mp' && !isWechatMp()) return true
		if (isWechatMp() && wechatPhoneFailCount.value >= 1) return true
		if ((p === 'feishu' || p === 'dingtalk' || p === 'wecom') && runPlatform.value === 'h5') return true
		return false
	})

	function getRedirectPath(): string {
		const pages = getCurrentPages()
		const cur = pages.length > 0 ? (pages[pages.length - 1] as any) : null
		let redirectPath = '/pages/my/my'
		if (cur != null && cur.options != null && cur.options['redirect'] != null) {
			const r = decodeURIComponent((cur.options['redirect'] as string).trim())
			if (r.length > 0 && r.indexOf('login') < 0) {
				redirectPath = r.startsWith('/') ? r : '/' + r
			}
		}
		return redirectPath
	}

	function doRedirect(path: string): void {
		const tabPaths = ['/pages/index/index', '/pages/exam-list/exam-list', '/pages/my/my']
		const isTab = tabPaths.indexOf(path) >= 0
		const fullPath = path.startsWith('/') ? path : '/' + path
		if (isTab) {
			uni.switchTab({ url: fullPath })
		} else {
			uni.reLaunch({ url: fullPath })
		}
	}

	function onLoginSuccess(): void {
		uni.showToast({ title: '登录成功', icon: 'success' })
		setTimeout(() => doRedirect(getRedirectPath()), 500)
	}

	onLoad((options: any) => {
		runPlatform.value = getRunPlatform()
		if (options != null && options['mode'] === 'password' && isWechatMp()) {
			wechatPhoneFailCount.value = 1
		}
		loadBranding()
		loadPlatformInfo()
		if (options != null && options['code'] != null && (options['code'] as string).length > 0) {
			handleOAuthCallback(options['code'] as string)
		}
	})

	async function loadBranding(): Promise<void> {
		try {
			const title = await getConfigByKey('site.title')
			if (title != null && title.length > 0) siteTitle.value = title
		} catch (_e) {}
		try {
			const logo = await getConfigByKey('site.logo')
			if (logo != null && logo.length > 0) siteLogo.value = logo
		} catch (_e) {}
	}

	async function loadPlatformInfo(): Promise<void> {
		try {
			const info = await getPlatformInfo()
			if (info != null) {
				platformInfo.value = { platform: info.platform ?? 'feishu', authLabel: info.authLabel ?? '企业' }
				authLabel.value = (info.authLabel != null && (info.authLabel as string).length > 0) ? (info.authLabel as string) : '企业'
			} else {
				platformInfo.value = { platform: 'feishu', authLabel: '企业' }
			}
		} catch (_e) {
			platformInfo.value = { platform: 'feishu', authLabel: '企业' }
		}
		if (needQrcodeLogin() && platformInfo.value != null && (platformInfo.value.platform === 'feishu' || platformInfo.value.platform === 'dingtalk' || platformInfo.value.platform === 'wecom')) {
			loadQrcode()
		}
	}

	async function getRedirectBaseUri(): Promise<string> {
		try {
			const base = await getConfigByKey('app.redirect_uri')
			if (base != null && base.length > 0) return base.replace(/\/$/, '')
		} catch (_e) {}
		return ''
	}

	async function loadQrcode(): Promise<void> {
		const p = platformInfo.value
		if (p == null) return
		if (p.platform === 'feishu') {
			qrcodeLoading.value = true
			try {
				let base = await getRedirectBaseUri()
				if (base.length === 0) {
					// #ifdef H5
					try {
						const w = typeof globalThis !== 'undefined' ? (globalThis as any) : null
						if (w != null && w.location != null) {
							const loc = w.location
							base = (loc.origin ?? '') + (loc.pathname ?? '/')
						}
					} catch (_e2) {}
					// #endif
				}
				const redirectUri = base.length > 0 ? (base + '?redirect=' + encodeURIComponent(getRedirectPath())) : ''
				if (redirectUri.length === 0) return
				const res = await getFeishuQrcode(redirectUri, null)
				if (res != null && res.goto != null && res.goto.length > 0) {
					qrcodeUrl.value = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(res.goto)
				}
			} catch (_e) {}
			finally {
				qrcodeLoading.value = false
			}
		}
	}

	async function handleThirdPartyAuth(): Promise<void> {
		const p = platformInfo.value
		if (p == null || p.platform !== 'feishu') return
		loading.value = true
		try {
			let base = await getRedirectBaseUri()
			if (base.length === 0) {
				// #ifdef H5
				try {
					const w = typeof globalThis !== 'undefined' ? (globalThis as any) : null
					if (w != null && w.location != null) {
						const loc = w.location
						base = (loc.origin ?? '') + (loc.pathname ?? '/')
					}
				} catch (_e2) {}
				// #endif
			}
			if (base.length === 0) {
				uni.showToast({ title: '请配置 app.redirect_uri', icon: 'none' })
				return
			}
			const redirectUri = base + '?redirect=' + encodeURIComponent(getRedirectPath())
			const res = await getFeishuAuthUrl(redirectUri, null, 'mobile')
			if (res != null && res.url != null && res.url.length > 0) {
				// #ifdef H5
				try {
					const w = typeof globalThis !== 'undefined' ? (globalThis as any) : null
					if (w != null && w.location != null && (w as any).location != null) {
						(w as any).location.href = res.url
						return
					}
				} catch (_e2) {}
				// #endif
				uni.showToast({ title: '请在浏览器中打开链接', icon: 'none' })
			}
		} catch (_e) {}
		finally {
			loading.value = false
		}
	}

	async function handleOAuthCallback(code: string): Promise<void> {
		loading.value = true
		try {
			let base = await getRedirectBaseUri()
			if (base.length === 0) {
				// #ifdef H5
				try {
					const w = typeof globalThis !== 'undefined' ? (globalThis as any) : null
					if (w != null && w.location != null) {
						const loc = w.location
						base = (loc.origin ?? '') + (loc.pathname ?? '/')
					}
				} catch (_e2) {}
				// #endif
			}
			const redirectUri = base.length > 0 ? (base + '?redirect=' + encodeURIComponent(getRedirectPath())) : ''
			const res = await feishuCallback(code, redirectUri)
			if (res != null && res.token != null) {
				setToken(res.token)
				if (res.userInfo != null) setUser(res.userInfo)
				onLoginSuccess()
			}
		} catch (_e) {}
		finally {
			loading.value = false
		}
	}

	async function handleWechatPhone(e: any): Promise<void> {
		const detail = e != null ? e.detail : null
		if (detail == null) {
			if (e.errMsg != null && (e.errMsg as string).indexOf('cancel') >= 0) return
			wechatPhoneFailCount.value++
			uni.showToast({ title: '需授权手机号才能登录', icon: 'none' })
			if (wechatPhoneFailCount.value >= 1) {
				uni.showToast({ title: '请使用账号密码登录', icon: 'none', duration: 2000 })
			}
			return
		}
		const phoneCode = (detail.code != null ? detail.code : '') as string
		if (phoneCode.length === 0) {
			wechatPhoneFailCount.value++
			uni.showToast({ title: '获取手机号失败', icon: 'none' })
			if (wechatPhoneFailCount.value >= 1) {
				uni.showToast({ title: '请使用账号密码登录', icon: 'none', duration: 2000 })
			}
			return
		}
		loading.value = true
		try {
			let code = wxLoginCode.value
			if (code.length === 0) {
				const loginRes = await new Promise<any>((resolve) => {
					uni.login({ provider: 'weixin', success: (r) => resolve(r), fail: () => resolve(null) })
				})
				code = (loginRes != null && loginRes.code != null) ? (loginRes.code as string) : ''
			}
			const res = await wechatMpPhoneLogin(code, phoneCode)
			if (res != null && res.token != null) {
				setToken(res.token)
				if (res.userInfo != null) setUser(res.userInfo)
				onLoginSuccess()
			}
		} catch (_e) {
			wechatPhoneFailCount.value++
			uni.showToast({ title: '获取手机号失败', icon: 'none' })
			if (wechatPhoneFailCount.value >= 1) {
				uni.showToast({ title: '请使用账号密码登录', icon: 'none', duration: 2000 })
			}
		}
		finally {
			loading.value = false
		}
	}

	// 微信小程序：手机号登录、账号密码登录均需 openid 存 union_id，进入页面即获取 code
	onShow(() => {
		if (isWechatMp()) {
			uni.login({
				provider: 'weixin',
				success: (r) => {
					if (r.code != null) wxLoginCode.value = r.code as string
				}
			})
		}
	})

	async function handleLogin(): Promise<void> {
		const u = username.value.trim()
		const p = password.value.trim()
		if (u.length === 0) {
			uni.showToast({ title: '请输入手机号', icon: 'none' })
			return
		}
		if (p.length === 0) {
			uni.showToast({ title: '请输入密码', icon: 'none' })
			return
		}
		loading.value = true
		try {
			let wxCode = ''
			if (isWechatMp() && wxLoginCode.value.length > 0) {
				wxCode = wxLoginCode.value
			} else if (isWechatMp()) {
				const loginRes = await new Promise<any>((resolve) => {
					uni.login({ provider: 'weixin', success: (r) => resolve(r), fail: () => resolve(null) })
				})
				wxCode = (loginRes != null && loginRes.code != null) ? (loginRes.code as string) : ''
			}
			const res = await login(u, p, wxCode)
			if (res != null && res.token != null) {
				setToken(res.token)
				if (res.userInfo != null) setUser(res.userInfo)
				onLoginSuccess()
			}
		} catch (_e) {}
		finally {
			loading.value = false
		}
	}
</script>

<style>
.page { flex: 1; flex-direction: column; }
.logo-block { flex-direction: column; align-items: center; padding: 40px 24px 32px; flex-shrink: 0; }
.logo-fixed { position: fixed; top: 0; left: 0; right: 0; z-index: 10; background: var(--brand-gradient-immersive); }
.logo-spacer { height: 220px; flex-shrink: 0; }
.page-body { flex: 1; }
.content { flex-direction: column; padding: 0 24px 40px; min-height: 320px; }
.login-logo { width: 72px; height: 72px; margin-bottom: 12px; flex-shrink: 0; }
.login-title { font-size: 28px; color: var(--brand-primary); font-weight: 600; flex-shrink: 0; }
.login-subtitle { font-size: 16px; color: #969799; margin-top: 8px; flex-shrink: 0; white-space: nowrap; }
.auth-block, .qrcode-block, .wechat-block { flex-direction: column; align-items: center; margin-bottom: 24px; }
.auth-btn { background-color: var(--brand-primary); color: #ffffff; border-radius: 24px; height: 44px; line-height: 44px; font-size: 16px; width: 100%; }
.qrcode-hint, .wechat-hint { font-size: 14px; color: #646566; margin-bottom: 16px; }
.qrcode-img { width: 200px; height: 200px; }
.qrcode-loading { width: 200px; height: 200px; align-items: center; justify-content: center; background-color: #f5f6f8; border-radius: 8px; }
.qrcode-loading-text { font-size: 14px; color: #969799; }
.switch-link { font-size: 12px; color: var(--brand-primary); margin-top: 12px; }
.switch-link-top { margin-top: 0; margin-bottom: 16px; }
.form-block { flex-direction: column; }
.field-row {
	flex-direction: row;
	align-items: center;
	margin-bottom: 16px;
	background-color: #ffffff;
	border-width: 1px;
	border-color: #d9e3f0;
	border-style: solid;
	border-radius: 8px;
	padding: 0 12px;
	min-height: 48px;
}
.field-label { font-size: 14px; color: #323233; width: 56px; flex-shrink: 0; }
.field-input { flex: 1; font-size: 14px; height: 46px; padding: 0 8px; background-color: transparent; }
.eye-btn { width: 22px; height: 22px; margin-left: 4px; flex-shrink: 0; tint-color: #969799; }
.submit-btn { background-color: var(--brand-primary); color: #ffffff; border-radius: 24px; height: 44px; line-height: 44px; font-size: 16px; margin-top: 30px; }
</style>
