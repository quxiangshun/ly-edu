<template>
	<view class="page" :style="themeRootStyle">
		<!-- 固定顶部：视频播放器 -->
		<view class="video-fixed">
			<view v-if="currentVideo == null" class="cover-wrap" @click="playFirst">
				<image class="cover-img" :src="coverImageUrl" mode="aspectFill"></image>
				<view class="cover-mask">
					<text class="play-hint">点击选择视频播放</text>
				</view>
			</view>
			<video
				v-else
				id="course-video"
				class="video-el"
				:src="currentVideoUrl"
				:poster="currentVideoPoster"
				:autoplay="shouldAutoplay"
				controls
				@play="onVideoPlay"
				@timeupdate="onTimeUpdate"
				@ended="onVideoEnded"
			></video>
		</view>

		<!-- 可滚动区域：课程信息 + 吸顶tab + 内容（H5 不动态隐藏信息，避免滚动时高度变化导致跳动） -->
		<scroll-view
			class="scroll-area"
			scroll-y="true"
			:style="scrollAreaStyle"
		>
			<view class="info-section">
				<text class="course-title">{{ detail != null ? detail.course.title : '' }}</text>
				<view class="meta-row">
					<text v-if="detail != null && (detail.course.isRequired ?? detail.course.is_required) === 1" class="tag required">必修</text>
					<text v-else-if="detail != null && (detail.course.isRequired ?? detail.course.is_required) === 0" class="tag elective">选修</text>
					<text v-if="videoCount > 0" class="meta-text">{{ videoCount }} 节视频</text>
				</view>
				<text class="course-desc">{{ detail != null && detail.course.description != null ? detail.course.description : '暂无描述' }}</text>
				<view v-if="detail != null && detail.courseProgress != null" class="progress-row">
					<text class="progress-text">已学 {{ Math.round(detail.courseProgress) }}%</text>
				</view>
			</view>
			<view class="tab-row tab-sticky">
				<view :class="['tab-item', activeTab === 'catalog' ? 'tab-item--active' : '']" @click="activeTab = 'catalog'">
					<text class="tab-text">目录</text>
				</view>
				<view :class="['tab-item', activeTab === 'attachment' ? 'tab-item--active' : '']" @click="activeTab = 'attachment'">
					<text class="tab-text">附件</text>
				</view>
				<view :class="['tab-item', activeTab === 'comment' ? 'tab-item--active' : '']" @click="activeTab = 'comment'">
					<text class="tab-text">评论</text>
				</view>
			</view>
			<view v-show="activeTab === 'catalog'" class="tab-panel">
				<view v-for="(ch, chIdx) in chaptersWithVideos" :key="ch.id ?? chIdx" class="chapter-block">
					<view class="chapter-header">
						<text class="chapter-num">第{{ chIdx + 1 }}章</text>
						<text class="chapter-title">{{ ch.title }}</text>
					</view>
					<view v-for="(v, vidx) in ch.hours" :key="v.id" class="video-row" :class="currentVideo != null && currentVideo.id === v.id ? 'video-row--active' : ''" @click="playVideo(v)">
						<image class="video-cover" :src="videoCoverUrl(v.cover)" mode="aspectFill"></image>
						<view class="video-info">
							<text class="video-title">{{ vidx + 1 }}. {{ v.title }}</text>
							<text class="video-meta">{{ formatDuration(v.duration) }}</text>
						</view>
					</view>
				</view>
				<view v-if="detail != null && detail.videos != null && detail.videos.length > 0 && chaptersWithVideos.length === 0">
					<view v-for="(v, idx) in detail.videos" :key="v.id" class="video-row" :class="currentVideo != null && currentVideo.id === v.id ? 'video-row--active' : ''" @click="playVideo(v)">
						<image class="video-cover" :src="videoCoverUrl(v.cover)" mode="aspectFill"></image>
						<view class="video-info">
							<text class="video-title">{{ idx + 1 }}. {{ v.title }}</text>
							<text class="video-meta">{{ formatDuration(v.duration) }}</text>
						</view>
					</view>
				</view>
				<view v-if="videoCount === 0" class="empty-tip">
					<text class="empty-text">暂无课时</text>
				</view>
			</view>
			<view v-show="activeTab === 'attachment'" class="tab-panel">
				<view v-if="detail != null && detail.attachments != null && detail.attachments.length > 0">
					<view v-for="att in detail.attachments" :key="att.id" class="attach-row">
						<text class="attach-name">{{ att.name }}</text>
						<image class="attach-download-icon" src="/static/icons/iconify/ri--download-line.svg" mode="aspectFit" @click="handleAttachment(att)"></image>
					</view>
				</view>
				<view v-else class="empty-tip">
					<text class="empty-text">暂无附件</text>
				</view>
			</view>
			<view v-show="activeTab === 'comment'" class="tab-panel comment-tab-panel">
				<view v-if="commentLoading" class="comment-loading">
					<text class="empty-text">加载中...</text>
				</view>
				<view v-else-if="commentTree.length > 0" class="comment-conversation">
					<view v-for="node in commentTree" :key="node.id" class="comment-thread">
						<view class="comment-bubble comment-bubble--parent">
							<view class="comment-bubble-header">
								<text class="comment-bubble-user">{{ node.username ?? '用户' }}</text>
								<text class="comment-bubble-time">{{ formatCommentTime(node.createTime ?? node.create_time) }}</text>
								<view class="comment-bubble-actions">
									<view class="comment-reply-wrap" @click="replyComment(node)">
										<text class="comment-reply-text">回复</text>
									</view>
									<view v-if="isOwnComment(node)" class="comment-delete-wrap" @click="deleteComment(node)">
										<text class="comment-delete-text">删除</text>
									</view>
								</view>
							</view>
							<text class="comment-bubble-content">{{ node.content }}</text>
						</view>
						<view v-if="node.replies != null && node.replies.length > 0" class="comment-replies-flat">
							<view v-for="r in node.replies" :key="r.id" class="comment-bubble comment-bubble--reply">
								<view class="comment-bubble-header">
									<text class="comment-bubble-user">{{ r.username ?? '用户' }}{{ r.parentAuthorName != null ? ' 回复 ' + r.parentAuthorName : '' }}</text>
									<text class="comment-bubble-time">{{ formatCommentTime(r.createTime ?? r.create_time) }}</text>
									<view class="comment-bubble-actions">
										<view class="comment-reply-wrap" @click="replyComment(r)">
											<text class="comment-reply-text">回复</text>
										</view>
										<view v-if="isOwnComment(r)" class="comment-delete-wrap" @click="deleteComment(r)">
											<text class="comment-delete-text">删除</text>
										</view>
									</view>
								</view>
								<text class="comment-bubble-content">{{ r.content }}</text>
							</view>
						</view>
					</view>
				</view>
				<view v-else class="empty-tip">
					<text class="empty-text">暂无评论</text>
				</view>
			</view>
		</scroll-view>

		<view v-if="activeTab === 'comment'" class="comment-bar-fixed">
			<view v-if="replyTo != null" class="comment-bar-cancel" @click="replyTo = null">
				<text class="comment-bar-cancel-text">取消回复</text>
			</view>
			<view class="comment-bar-inner">
				<textarea
					id="comment-input"
					class="comment-bar-input"
					v-model="commentContent"
					:placeholder="commentPlaceholder"
					:maxlength="500"
					:auto-height="true"
					:focus="commentInputFocused"
				/>
				<view class="comment-bar-send" :class="commentSubmitting ? 'comment-bar-send--disabled' : ''" @click="submitComment">
					<text class="comment-bar-send-text">回复</text>
				</view>
			</view>
		</view>

		<view v-if="loading" class="loading-overlay">
			<text class="loading-text">加载中...</text>
		</view>
		<view v-else-if="detail == null" class="empty-overlay">
			<text class="empty-text">课程不存在</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, watch, nextTick } from 'vue'
	import { getCourseById, getCourseComments, addCourseComment, deleteCourseComment, type CourseCommentDto } from '../../api/course'
	import { recordPlay } from '../../api/video'
	import { updateVideoProgress } from '../../api/learning'
	import { assetUrl } from '../../config/api'
	import { joinCourse } from '../../api/learning'
	import { themePrimary } from '../../utils/theme'
	import { getUser } from '../../utils/auth'
	import { getDownloadFilePath, buildDownloadFileName } from '../../utils/file'
	// #ifdef H5
	import { downloadFileH5 } from '../../utils/file'
	// #endif

	const themeRootStyle = computed((): Record<string, string> => ({ '--brand-primary': themePrimary.value }))

	const VIDEO_HEIGHT = 220
	const courseId = ref(0)
	const initVideoId = ref(0)
	const loading = ref(true)
	const detail = ref<any>(null)
	const currentVideo = ref<any>(null)
	const shouldAutoplay = ref(false)
	const activeTab = ref<'catalog' | 'attachment' | 'comment'>('catalog')
	const comments = ref<CourseCommentDto[]>([])
	const commentLoading = ref(false)
	/** 扁平结构：一级评论 + 所有回复同级展示。回复的回复显示「B 回复 C」 */
	function buildFlatThreads(list: CourseCommentDto[]): any[] {
		const idMap = new Map<number, CourseCommentDto>()
		for (let i = 0; i < list.length; i++) {
			idMap.set(list[i].id, list[i])
		}
		const roots = list.filter((c) => c.parentId == null || c.parentId === 0)
		const children = list.filter((c) => c.parentId != null && c.parentId !== 0)
		function getRootId(cid: number): number {
			const c = idMap.get(cid)
			if (c == null) return cid
			if (c.parentId == null || c.parentId === 0) return c.id
			return getRootId(c.parentId)
		}
		const byRoot = new Map<number, any[]>()
		for (let i = 0; i < children.length; i++) {
			const r = children[i]
			const rootId = getRootId(r.parentId)
			const parent = idMap.get(r.parentId)
			const parentName = parent != null ? (parent.username ?? '用户') : '用户'
			const arr = byRoot.get(rootId) ?? []
			arr.push({ ...r, parentAuthorName: parentName })
			byRoot.set(rootId, arr)
		}
		for (const [id, arr] of byRoot) {
			arr.sort((a, b) => {
				const ta = (a.createTime ?? a.create_time ?? '').toString()
				const tb = (b.createTime ?? b.create_time ?? '').toString()
				return ta.localeCompare(tb)
			})
		}
		return roots.map((r) => ({
			...r,
			replies: (byRoot.get(r.id) ?? [])
		}))
	}
	const commentTree = computed((): any[] => {
		const list = comments.value
		if (list == null || list.length === 0) return []
		return buildFlatThreads(list)
	})
	const commentPlaceholder = computed((): string => {
		const me = getUser()
		const meName = me != null ? ((me['username'] ?? '我') as string) : '我'
		const rt = replyTo.value
		if (rt != null) {
			const targetName = rt.username ?? '用户'
			return meName + ' 回复 ' + targetName + ': '
		}
		return meName + ' 发表评论: '
	})
	const commentInputFocused = ref(false)
	const commentContent = ref('')
	const commentSubmitting = ref(false)
	const replyTo = ref<CourseCommentDto | null>(null)
	const lastSaveAt = ref(0)
	const SAVE_INTERVAL = 5000
	let playedCurrent = false

	const scrollAreaStyle = computed((): Record<string, string> => {
		const sys = uni.getSystemInfoSync()
		const h = (sys.windowHeight ?? sys.screenHeight ?? 600) - VIDEO_HEIGHT
		return { height: h + 'px' }
	})

	onLoad((options: any) => {
		if (options != null && options['id'] != null) {
			courseId.value = parseInt(options['id'] as string)
		}
		if (options != null && options['videoId'] != null) {
			initVideoId.value = parseInt(options['videoId'] as string)
		}
		loadDetail()
	})

	watch(activeTab, (tab) => {
		if (tab === 'comment' && comments.value.length === 0 && !commentLoading.value) {
			loadComments()
		}
	})

	const videoCount = computed(() => {
		const d = detail.value
		if (d == null || d.videos == null) return 0
		return d.videos.length
	})

	const chaptersWithVideos = computed(() => {
		const d = detail.value
		if (d == null || d.chapters == null) return []
		const chs = d.chapters as any[]
		const result: any[] = []
		for (let i = 0; i < chs.length; i++) {
			const ch = chs[i]
			if (ch.hours != null && ch.hours.length > 0) {
				result.push(ch)
			}
		}
		return result
	})

	const coverImageUrl = computed((): string => {
		const d = detail.value
		const cover = d?.course?.cover
		if (cover != null && cover.length > 0) {
			const u = assetUrl(cover)
			if (u.length > 0) return u
		}
		return '/static/logo.png'
	})

	const currentVideoUrl = computed((): string => {
		const v = currentVideo.value
		if (v == null || v.url == null) return ''
		const url = String(v.url).trim()
		if (url.startsWith('http')) return url
		const u = assetUrl(url)
		return u.length > 0 ? u : ''
	})

	const currentVideoPoster = computed((): string => {
		const v = currentVideo.value
		if (v == null || v.cover == null) return ''
		const u = assetUrl(v.cover)
		return u.length > 0 ? u : ''
	})

	function videoCoverUrl(cover: string | null | undefined): string {
		if (cover != null && cover.length > 0) {
			const u = assetUrl(cover)
			if (u.length > 0) return u
		}
		return '/static/logo.png'
	}

	function formatCommentTime(t: string | null | undefined): string {
		if (t == null || t.length === 0) return ''
		const s = String(t).replace('T', ' ').trim()
		const ms = Date.parse(s)
		if (isNaN(ms)) return s.length >= 10 ? s.substring(0, 10) : s
		const diff = Math.floor((Date.now() - ms) / 1000)
		if (diff < 60) return '刚刚'
		if (diff < 3600) return Math.floor(diff / 60).toString() + '分钟前'
		if (diff < 86400) return Math.floor(diff / 3600).toString() + '小时前'
		if (diff < 2592000) return Math.floor(diff / 86400).toString() + '天前'
		return s.length >= 10 ? s.substring(0, 10) : s
	}

	function formatDuration(sec: number | null | undefined): string {
		if (sec == null) return ''
		const s = Math.floor(sec)
		const m = Math.floor(s / 60)
		const h = Math.floor(m / 60)
		const mm = m % 60
		const ss = s % 60
		if (h > 0) return h.toString() + ':' + (mm < 10 ? '0' : '') + mm + ':' + (ss < 10 ? '0' : '') + ss
		return (mm < 10 ? '0' : '') + mm + ':' + (ss < 10 ? '0' : '') + ss
	}

	async function loadComments(): Promise<void> {
		if (courseId.value <= 0) return
		commentLoading.value = true
		try {
			const list = await getCourseComments(courseId.value, null)
			comments.value = list != null && Array.isArray(list) ? list : []
		} catch (_e) {
			comments.value = []
		} finally {
			commentLoading.value = false
		}
	}

	function replyComment(c: CourseCommentDto): void {
		replyTo.value = c
		commentInputFocused.value = true
		setTimeout(() => {
			commentInputFocused.value = false
		}, 100)
	}

	async function submitComment(): Promise<void> {
		const content = (commentContent.value ?? '').trim()
		if (content.length === 0) {
			uni.showToast({ title: '请输入评论内容', icon: 'none' })
			return
		}
		if (commentSubmitting.value) return
		commentSubmitting.value = true
		const rt = replyTo.value
		try {
			await addCourseComment(courseId.value, {
				content: content,
				parentId: rt != null ? rt.id : null
			})
			uni.showToast({ title: rt != null ? '回复成功' : '评论成功', icon: 'success' })
			commentContent.value = ''
			replyTo.value = null
			await loadComments()
		} catch (e: any) {
			const msg = e?.message ?? e?.errMsg ?? '发表失败'
			uni.showToast({ title: String(msg), icon: 'none' })
		} finally {
			commentSubmitting.value = false
		}
	}

	function isOwnComment(c: CourseCommentDto): boolean {
		const u = getUser()
		if (u == null) return false
		const uid = u['id'] ?? u['userId']
		const cUid = c.userId ?? (c as any)['user_id']
		return uid != null && cUid != null && Number(uid) === Number(cUid)
	}

	async function deleteComment(c: CourseCommentDto): Promise<void> {
		if (!isOwnComment(c)) return
		uni.showModal({
			title: '提示',
			content: '确定要删除这条评论吗？',
			success: async (res) => {
				if (res.confirm) {
					try {
						await deleteCourseComment(c.id)
						uni.showToast({ title: '已删除', icon: 'success' })
						await loadComments()
					} catch (_e) {
						uni.showToast({ title: '删除失败', icon: 'none' })
					}
				}
			}
		})
	}

	async function loadDetail(): Promise<void> {
		if (courseId.value <= 0) {
			uni.navigateBack()
			return
		}
		loading.value = true
		try {
			const res = await getCourseById(courseId.value)
			detail.value = res
			if (initVideoId.value > 0) {
				const v = findVideoById(res, initVideoId.value)
				if (v != null) {
					currentVideo.value = v
					shouldAutoplay.value = true
					playedCurrent = false
				}
			}
		} catch (_e) {
			uni.showToast({ title: '加载失败', icon: 'none' })
			uni.navigateBack()
		} finally {
			loading.value = false
		}
	}

	function findVideoById(d: any, id: number): any | null {
		if (d == null) return null
		const chs = d.chapters
		if (chs != null) {
			for (let i = 0; i < chs.length; i++) {
				const hrs = chs[i].hours
				if (hrs != null) {
					for (let j = 0; j < hrs.length; j++) {
						if (hrs[j].id === id) return hrs[j]
					}
				}
			}
		}
		const vs = d.videos
		if (vs != null) {
			for (let i = 0; i < vs.length; i++) {
				if (vs[i].id === id) return vs[i]
			}
		}
		return null
	}

	function playFirst(): void {
		const d = detail.value
		const first = d?.chapters?.[0]?.hours?.[0] ?? d?.videos?.[0]
		if (first != null) playVideo(first)
	}

	async function playVideo(v: any): void {
		if (uni.getStorageSync('token') == null) {
			uni.showToast({ title: '请先登录', icon: 'none' })
			uni.navigateTo({ url: '/pages/login/login?redirect=' + encodeURIComponent('/pages/course-detail/course-detail?id=' + courseId.value + '&videoId=' + v.id) })
			return
		}
		try {
			await joinCourse(courseId.value)
		} catch (_e) {
			uni.showToast({ title: '加入课程失败', icon: 'none' })
			return
		}
		currentVideo.value = v
		shouldAutoplay.value = true
		playedCurrent = false
		nextTick(() => {
			const ctx = uni.createVideoContext('course-video')
			if (ctx != null) {
				ctx.play()
			}
		})
	}

	function onVideoPlay(): void {
		if (!playedCurrent && currentVideo.value != null) {
			playedCurrent = true
			recordPlay(currentVideo.value.id).catch(() => {})
		}
	}

	function onTimeUpdate(e: any): void {
		const v = currentVideo.value
		if (v == null) return
		const cur = e?.detail?.currentTime ?? 0
		const dur = e?.detail?.duration ?? v?.duration ?? 0
		if (cur < 1 || dur <= 0) return
		const now = Date.now()
		if (now - lastSaveAt.value < SAVE_INTERVAL) return
		lastSaveAt.value = now
		updateVideoProgress(v.id, Math.floor(cur), Math.floor(dur)).catch(() => {})
	}

	function onVideoEnded(e: any): void {
		const v = currentVideo.value
		if (v == null) return
		const cur = e?.detail?.currentTime ?? 0
		const dur = e?.detail?.duration ?? v?.duration ?? 0
		if (dur > 0) {
			updateVideoProgress(v.id, Math.floor(cur), Math.floor(dur)).catch(() => {})
		}
	}

	function handleAttachment(att: any): void {
		const url = att.fileUrl ?? att.file_url
		if (url == null || url.length === 0) {
			uni.showToast({ title: '附件地址无效', icon: 'none' })
			return
		}
		const fullUrl = assetUrl(url)
		if (fullUrl.length === 0) {
			uni.showToast({ title: '附件地址无效', icon: 'none' })
			return
		}
		const name = att.name ?? att.title ?? '附件'
		const fileType = att.type ?? att.fileType ?? att.file_type
		const fileName = buildDownloadFileName(name, fileType, url)
		// #ifdef H5
		downloadFileH5(fullUrl, fileName, () => {
			uni.showToast({ title: '下载完成', icon: 'success' })
		})
		// #endif
		// #ifndef H5
		const customPath = getDownloadFilePath(name, fileType, url)
		if (customPath != null) {
			uni.downloadFile({
				url: fullUrl,
				filePath: customPath,
				success: (res) => {
					const path = res.filePath ?? res.tempFilePath
					if (res.statusCode === 200 && path != null && path.length > 0) {
						uni.openDocument({ filePath: path })
					}
				}
			})
		} else {
			uni.downloadFile({
				url: fullUrl,
				success: (res) => {
					const path = res.tempFilePath
					if (res.statusCode === 200 && path != null && path.length > 0) {
						uni.openDocument({ filePath: path })
					}
				}
			})
		}
		// #endif
	}
</script>

<style>
.page {
	flex: 1;
	flex-direction: column;
	position: relative;
}
.video-fixed {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	height: 220px;
	z-index: 10;
	background-color: #000000;
}
.cover-wrap {
	width: 100%;
	height: 100%;
	position: relative;
	background-color: #e8f4ff;
}
.cover-img {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}
.cover-mask {
	position: absolute;
