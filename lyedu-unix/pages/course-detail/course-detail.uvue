<template>
	<scroll-view class="page" scroll-y="true" style="flex:1">
		<view v-if="loading" class="loading-wrap">
			<text class="loading-text">加载中...</text>
		</view>
		<view v-else-if="detail != null" class="content">
			<view class="cover-wrap" :style="coverStyle">
				<view class="cover-mask" @click="playFirst">
					<text class="play-hint">点击选择视频播放</text>
				</view>
			</view>
			<view class="info-section">
				<text class="course-title">{{ detail.course.title }}</text>
				<view class="meta-row">
					<text v-if="detail.course.isRequired === 1" class="tag required">必修</text>
					<text v-else-if="detail.course.isRequired === 0" class="tag elective">选修</text>
					<text v-if="videoCount > 0" class="meta-text">{{ videoCount }} 节视频</text>
				</view>
				<text class="course-desc">{{ detail.course.description != null ? detail.course.description : '暂无描述' }}</text>
				<view v-if="detail.courseProgress != null" class="progress-row">
					<text class="progress-text">已学 {{ Math.round(detail.courseProgress) }}%</text>
				</view>
			</view>

			<view class="section">
				<text class="section-title">课程目录</text>
				<view v-for="(ch, chIdx) in chaptersWithVideos" :key="ch.id ?? chIdx" class="chapter-block">
					<view class="chapter-header">
						<text class="chapter-num">第{{ chIdx + 1 }}章</text>
						<text class="chapter-title">{{ ch.title }}</text>
					</view>
					<view v-for="(v, vidx) in ch.hours" :key="v.id" class="video-row" @click="playVideo(v)">
						<text class="video-title">{{ vidx + 1 }}. {{ v.title }}</text>
						<text class="video-meta">{{ formatDuration(v.duration) }}</text>
					</view>
				</view>
				<view v-if="detail.videos != null && detail.videos.length > 0 && chaptersWithVideos.length === 0">
					<view v-for="(v, idx) in detail.videos" :key="v.id" class="video-row" @click="playVideo(v)">
						<text class="video-title">{{ idx + 1 }}. {{ v.title }}</text>
						<text class="video-meta">{{ formatDuration(v.duration) }}</text>
					</view>
				</view>
				<view v-if="videoCount === 0" class="empty-tip">
					<text class="empty-text">暂无课时</text>
				</view>
			</view>

			<view v-if="detail.attachments != null && detail.attachments.length > 0" class="section">
				<text class="section-title">附件</text>
				<view v-for="att in detail.attachments" :key="att.id" class="attach-row" @click="handleAttachment(att)">
					<text class="attach-name">{{ att.name }}</text>
				</view>
			</view>

			<view class="bottom-bar">
				<button class="start-btn" @click="handleStartLearn">{{ detail.courseProgress != null && detail.courseProgress > 0 ? '继续学习' : '开始学习' }}</button>
			</view>
		</view>
		<view v-else class="empty-wrap">
			<text class="empty-text">课程不存在</text>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getCourseById } from '../../api/course'
	import { joinCourse } from '../../api/learning'

	const courseId = ref(0)
	const loading = ref(true)
	const detail = ref<any>(null)

	onLoad((options: any) => {
		if (options != null && options['id'] != null) {
			courseId.value = parseInt(options['id'] as string)
		}
		loadDetail()
	})

	const videoCount = computed(() => {
		const d = detail.value
		if (d == null || d.videos == null) return 0
		return d.videos.length
	})

	const chaptersWithVideos = computed(() => {
		const d = detail.value
		if (d == null || d.chapters == null) return []
		const chs = d.chapters as any[]
		const result: any[] = []
		for (let i = 0; i < chs.length; i++) {
			const ch = chs[i]
			if (ch.hours != null && ch.hours.length > 0) {
				result.push(ch)
			}
		}
		return result
	})

	const coverStyle = computed(() => {
		const d = detail.value
		const cover = d?.course?.cover
		if (cover != null && cover.length > 0) {
			const u = buildUrl(cover)
			return { backgroundImage: 'url(' + u + ')', backgroundSize: 'cover' }
		}
		return { backgroundColor: '#e8f4ff' }
	})

	function buildUrl(path: string): string {
		if (path.startsWith('http')) return path
		return '/api' + (path.startsWith('/') ? path : '/' + path)
	}

	function formatDuration(sec: number | null | undefined): string {
		if (sec == null) return ''
		const s = Math.floor(sec)
		const m = Math.floor(s / 60)
		const h = Math.floor(m / 60)
		const mm = m % 60
		const ss = s % 60
		if (h > 0) return h.toString() + ':' + (mm < 10 ? '0' : '') + mm + ':' + (ss < 10 ? '0' : '') + ss
		return (mm < 10 ? '0' : '') + mm + ':' + (ss < 10 ? '0' : '') + ss
	}

	async function loadDetail(): Promise<void> {
		if (courseId.value <= 0) {
			uni.navigateBack()
			return
		}
		loading.value = true
		try {
			const res = await getCourseById(courseId.value)
			detail.value = res
		} catch (_e) {
			uni.showToast({ title: '加载失败', icon: 'none' })
			uni.navigateBack()
		} finally {
			loading.value = false
		}
	}

	function playFirst(): void {
		const d = detail.value
		const first = d?.chapters?.[0]?.hours?.[0] ?? d?.videos?.[0]
		if (first != null) playVideo(first)
	}

	function playVideo(v: any): void {
		uni.navigateTo({ url: '/pages/video-player/video-player?id=' + v.id })
	}

	function handleAttachment(att: any): void {
		const url = att.fileUrl
		if (url == null || url.length === 0) {
			uni.showToast({ title: '附件地址无效', icon: 'none' })
			return
		}
		const fullUrl = url.startsWith('http') ? url : '/api' + (url.startsWith('/') ? url : '/' + url)
		uni.downloadFile({
			url: fullUrl,
			success: (res) => {
				if (res.statusCode === 200 && res.tempFilePath != null) {
					uni.openDocument({ filePath: res.tempFilePath })
				}
			}
		})
	}

	async function handleStartLearn(): Promise<void> {
		if (uni.getStorageSync('token') == null) {
			uni.showToast({ title: '请先登录', icon: 'none' })
			uni.navigateTo({ url: '/pages/login/login?redirect=' + encodeURIComponent('/pages/course-detail/course-detail?id=' + courseId.value) })
			return
		}
		try {
			await joinCourse(courseId.value)
			uni.showToast({ title: '已加入课程' })
			const d = detail.value
			const first = d?.chapters?.[0]?.hours?.[0] ?? d?.videos?.[0]
			if (first != null) {
				uni.navigateTo({ url: '/pages/video-player/video-player?id=' + first.id })
			}
		} catch (_e) {
			uni.showToast({ title: '加入课程失败', icon: 'none' })
		}
	}
</script>

<style>
.page {
	flex: 1;
	padding-bottom: 80px;
}
.loading-wrap {
	padding: 60px 0;
	align-items: center;
}
.loading-text {
	font-size: 14px;
	color: #969799;
}
.content {
	flex-direction: column;
}
.cover-wrap {
	width: 100%;
	height: 200px;
	background-color: #e8f4ff;
}
.cover-mask {
	flex: 1;
	align-items: center;
	justify-content: center;
}
.play-hint {
	font-size: 14px;
	color: rgba(255,255,255,0.9);
}
.info-section {
	flex-direction: column;
	padding: 16px;
	background-color: #ffffff;
}
.course-title {
	font-size: 18px;
	font-weight: 600;
	color: #323233;
}
.meta-row {
	flex-direction: row;
	align-items: center;
	margin-top: 8px;
}
.tag {
	font-size: 12px;
	padding: 2px 8px;
	border-radius: 4px;
	margin-right: 8px;
}
.required {
	background-color: #ffebee;
	color: #ee0a24;
}
.elective {
	background-color: #e8f4ff;
	color: #1989fa;
}
.meta-text {
	font-size: 13px;
	color: #969799;
}
.course-desc {
	font-size: 14px;
	color: #646566;
	margin-top: 10px;
	line-height: 1.5;
}
.progress-row {
	margin-top: 12px;
}
.progress-text {
	font-size: 12px;
	color: #969799;
}
.section {
	flex-direction: column;
	padding: 16px;
	margin-top: 12px;
	background-color: #ffffff;
}
.section-title {
	font-size: 16px;
	font-weight: 600;
	color: #323233;
	margin-bottom: 12px;
}
.chapter-block {
	flex-direction: column;
	margin-bottom: 16px;
}
.chapter-header {
	flex-direction: row;
	align-items: center;
	padding: 12px 0;
	background-color: #f7f8fa;
	border-radius: 8px;
	margin-bottom: 8px;
}
.chapter-num {
	font-size: 12px;
	color: #1989fa;
	margin-right: 8px;
}
.chapter-title {
	font-size: 15px;
	color: #323233;
}
.video-row {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 12px 0;
	border-bottom-width: 1px;
	border-bottom-color: #f0f0f0;
}
.video-title {
	font-size: 15px;
	color: #323233;
}
.video-meta {
	font-size: 12px;
	color: #969799;
}
.attach-row {
	padding: 12px 0;
	border-bottom-width: 1px;
	border-bottom-color: #f0f0f0;
}
.attach-name {
	font-size: 15px;
	color: #323233;
}
.empty-tip {
	padding: 24px 0;
	align-items: center;
}
.empty-text {
	font-size: 14px;
	color: #969799;
}
.bottom-bar {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 12px 16px;
	background-color: #ffffff;
	border-top-width: 1px;
	border-top-color: #ebedf0;
}
.start-btn {
	background-color: #1989fa;
	color: #ffffff;
	border-radius: 24px;
	height: 44px;
}
.empty-wrap {
	padding: 60px 0;
	align-items: center;
}
</style>
