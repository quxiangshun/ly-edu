<template>
	<scroll-view class="page" scroll-y="true" style="flex:1">
		<view class="content">
			<view v-if="record != null" class="result-block">
				<text class="result-title">{{ record.passed === 1 ? '考试通过' : '未通过' }}</text>
				<text class="result-score">得分：{{ record.score ?? 0 }} 分</text>
				<text v-if="record.submitTime != null" class="submit-time">交卷时间：{{ formatTime(record.submitTime) }}</text>
				<button class="back-btn" @click="navBack">返回考试列表</button>
			</view>
			<view v-else class="empty-wrap">
				<text class="empty-text">暂无成绩记录</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getMyRecords } from '../../api/exam'

	const examId = ref(0)
	const record = ref<any>(null)

	onLoad((options: any) => {
		if (options != null && options['id'] != null) {
			examId.value = parseInt(options['id'] as string)
		}
		loadResult()
	})

	function formatTime(s: string | null | undefined): string {
		if (s == null || s.length === 0) return '-'
		return s.replace('T', ' ').substring(0, 19)
	}

	async function loadResult(): Promise<void> {
		const cached = uni.getStorageSync('exam_result_' + examId.value)
		if (cached != null && (cached as string).length > 0) {
			try {
				record.value = JSON.parse(cached as string)
				return
			} catch (_e) {}
		}
		try {
			const list = await getMyRecords()
			const arr = Array.isArray(list) ? list : []
			for (let i = 0; i < arr.length; i++) {
				const r = arr[i] as any
				if (r.examId === examId.value) {
					record.value = r
					return
				}
			}
		} catch (_e) {}
	}

	function navBack(): void {
		uni.navigateTo({ url: '/pages/exam-list/exam-list' })
	}
</script>

<style>
.page {
	flex: 1;
}
.content {
	flex-direction: column;
	padding: 24px 16px;
}
.result-block {
	flex-direction: column;
	align-items: center;
}
.result-title {
	font-size: 20px;
	font-weight: 600;
	color: #323233;
}
.result-score {
	font-size: 18px;
	color: #323233;
	margin-top: 12px;
}
.submit-time {
	font-size: 13px;
	color: #969799;
	margin-top: 8px;
}
.back-btn {
	background-color: #1989fa;
	color: #ffffff;
	border-radius: 24px;
	margin-top: 24px;
	padding: 10px 32px;
}
.empty-wrap {
	padding: 40px 0;
	align-items: center;
}
.empty-text {
	font-size: 14px;
	color: #969799;
}
</style>
