<template>
	<view class="page" :style="themeRootStyle">
		<view v-if="loading" class="loading-wrap">
			<text class="loading-text">加载中...</text>
		</view>
		<view v-else-if="video != null" class="content">
			<video
				class="video-el"
				:src="videoUrl"
				:poster="posterUrl"
				controls
				@play="onPlay"
				@timeupdate="onTimeUpdate"
				@ended="onEnded"
			></video>
			<scroll-view class="info-scroll" scroll-y="true" style="flex:1">
				<view class="video-info">
					<text class="video-title">{{ video.title }}</text>
					<view class="video-meta-row">
						<text class="meta-item">{{ formatDuration(video.duration) }}</text>
						<text class="meta-item">播放 {{ video.playCount ?? 0 }} 次</text>
						<text class="meta-item like-item" @click="handleLike">{{ video.liked === true ? '已点赞' : '点赞' }} {{ video.likeCount ?? 0 }}</text>
					</view>
				</view>
				<view class="video-list-section">
					<text class="list-title">视频列表</text>
					<view v-for="(rv, idx) in relatedVideos" :key="rv.id" class="video-row" :class="rv.id === video.id ? 'active' : ''" @click="switchVideo(rv.id)">
						<text class="video-index">{{ idx + 1 }}</text>
						<view class="video-info-item">
							<text class="row-title">{{ rv.title }}</text>
							<text class="row-meta">{{ formatDuration(rv.duration) }} · {{ rv.playCount ?? 0 }} 播放</text>
						</view>
					</view>
				</view>
			</scroll-view>
		</view>
		<view v-else class="empty-wrap">
			<text class="empty-text">视频不存在</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { getVideoById, recordPlay, likeVideo, unlikeVideo } from '../../api/video'
	import { getCourseById } from '../../api/course'
	import { updateVideoProgress } from '../../api/learning'
	import { themePrimary } from '../../utils/theme'

	const themeRootStyle = computed((): Record<string, string> => ({ '--brand-primary': themePrimary.value }))

	const videoId = ref(0)
	const loading = ref(true)
	const video = ref<any>(null)
	const relatedVideos = ref<any[]>([])
	const lastSaveAt = ref(0)
	const SAVE_INTERVAL = 5000
	let played = false

	onLoad((options: any) => {
		if (options != null && options['id'] != null) {
			videoId.value = parseInt(options['id'] as string)
		}
		loadVideo()
	})

	onUnload(() => {
		// 离开时保存进度（需 video 组件 currentTime，uni-app video 可能不直接暴露，暂略）
	})

	const videoUrl = computed(() => {
		const v = video.value
		if (v == null || v.url == null) return ''
		let url = String(v.url).trim()
		if (url.startsWith('http')) return url
		const base = '/api'
		if (url.startsWith('/uploads/')) return base + url
		if (url.startsWith('/')) return base + url
		return base + '/uploads/' + url.replace(/^\/+/, '')
	})

	const posterUrl = computed(() => {
		const v = video.value
		if (v == null || v.cover == null) return ''
		let url = String(v.cover).trim()
		if (url.startsWith('http')) return url
		return '/api' + (url.startsWith('/') ? url : '/' + url)
	})

	function formatDuration(sec: number | null | undefined): string {
		if (sec == null) return '0:00'
		const s = Math.floor(sec)
		const m = Math.floor(s / 60)
		const h = Math.floor(m / 60)
		const mm = m % 60
		const ss = s % 60
		const mm2 = mm < 10 ? '0' + mm : '' + mm
		const ss2 = ss < 10 ? '0' + ss : '' + ss
		if (h > 0) return h + ':' + mm2 + ':' + ss2
		return mm + ':' + ss2
	}

	async function loadVideo(): Promise<void> {
		if (videoId.value <= 0) {
			uni.navigateBack()
			return
		}
		loading.value = true
		try {
			const v = await getVideoById(videoId.value)
			video.value = v
			if (v.courseId != null) {
				const course = await getCourseById(v.courseId)
				const chs = course?.chapters
				let vids: any[] = []
				if (chs != null && chs.length > 0) {
					for (let i = 0; i < chs.length; i++) {
						const hrs = chs[i].hours
						if (hrs != null) {
							for (let j = 0; j < hrs.length; j++) {
								vids.push(hrs[j])
							}
						}
					}
				}
				if (vids.length === 0 && course?.videos != null) {
					vids = course.videos
				}
				relatedVideos.value = vids
			} else {
				relatedVideos.value = [v]
			}
		} catch (_e) {
			uni.showToast({ title: '加载失败', icon: 'none' })
			uni.navigateBack()
		} finally {
			loading.value = false
		}
	}

	function onPlay(): void {
		if (!played) {
			played = true
			recordPlay(videoId.value).catch(() => {})
		}
	}

	function onTimeUpdate(e: any): void {
		const cur = e?.detail?.currentTime ?? 0
		const dur = e?.detail?.duration ?? video.value?.duration ?? 0
		if (cur < 1 || dur <= 0) return
		const now = Date.now()
		if (now - lastSaveAt.value < SAVE_INTERVAL) return
		lastSaveAt.value = now
		updateVideoProgress(videoId.value, Math.floor(cur), Math.floor(dur)).catch(() => {})
	}

	function onEnded(e: any): void {
		const cur = e?.detail?.currentTime ?? 0
		const dur = e?.detail?.duration ?? video.value?.duration ?? 0
		if (dur > 0) {
			updateVideoProgress(videoId.value, Math.floor(cur), Math.floor(dur)).catch(() => {})
		}
	}

	async function handleLike(): void {
		const v = video.value
		if (v == null) return
		try {
			if (v.liked === true) {
				await unlikeVideo(v.id)
				v.liked = false
				v.likeCount = (v.likeCount ?? 1) - 1
			} else {
				await likeVideo(v.id)
				v.liked = true
				v.likeCount = (v.likeCount ?? 0) + 1
			}
		} catch (_e) {}
	}

	function switchVideo(id: number): void {
		if (id === videoId.value) return
		videoId.value = id
		played = false
		loadVideo()
	}
</script>

<style>
.page {
	flex: 1;
	flex-direction: column;
	min-height: 100%;
}
.loading-wrap {
	flex: 1;
	align-items: center;
	justify-content: center;
}
.loading-text {
	font-size: 14px;
	color: #969799;
}
.content {
	flex: 1;
	flex-direction: column;
}
.video-el {
	width: 100%;
	height: 220px;
	background-color: #000000;
}
.info-scroll {
	flex: 1;
}
.video-info {
	flex-direction: column;
	padding: 16px;
}
.video-title {
	font-size: 18px;
	font-weight: 600;
	color: #323233;
}
.video-meta-row {
	flex-direction: row;
	margin-top: 8px;
}
.meta-item {
	font-size: 13px;
	color: #969799;
	margin-right: 16px;
}
.like-item {
	color: var(--brand-primary);
}
.video-list-section {
	flex-direction: column;
	padding: 0 16px 24px;
}
.list-title {
	font-size: 16px;
	color: #323233;
	margin-bottom: 12px;
}
.video-row {
	flex-direction: row;
	align-items: center;
	padding: 12px 0;
	border-bottom-width: 1px;
	border-bottom-color: #f0f0f0;
}
.video-row.active {
	background-color: #e8f4ff;
}
.video-index {
	font-size: 14px;
	color: #969799;
	width: 24px;
	margin-right: 12px;
}
.video-info-item {
	flex: 1;
	flex-direction: column;
}
.row-title {
	font-size: 15px;
	color: #323233;
}
.row-meta {
	font-size: 12px;
	color: #969799;
	margin-top: 4px;
}
.empty-wrap {
	flex: 1;
	align-items: center;
	justify-content: center;
}
.empty-text {
	font-size: 14px;
	color: #969799;
}
</style>
