<template>
	<view class="page" :style="themeRootStyle">
		<view class="page-header">
			<view class="container">
				<view class="search-bar">
					<input
						class="search-input"
						type="text"
						:value="keyword"
						placeholder="请输入视频名称、关键字"
						confirm-type="search"
						@input="handleSearchInput"
						@confirm="handleSearchConfirm"
					/>
					<text v-if="keyword.length > 0" class="search-clear" @click="clearKeyword">清除</text>
				</view>

				<!-- #ifdef H5 -->
				<view class="tag-scroll tag-scroll-h5">
					<view class="tag-row">
						<view
							v-for="(item, index) in categoryTabs"
							:key="item.id != null ? item.id : 'all'"
							:class="['tag-item', index === activeCategoryIndex ? 'tag-item--active' : '']"
							@click="handleCategoryChange(index)"
						>
							<text class="tag-text">{{ item.label }}</text>
							<view v-if="index === activeCategoryIndex" class="tag-indicator"></view>
						</view>
					</view>
				</view>
				<!-- #endif -->
				<!-- #ifndef H5 -->
				<scroll-view class="tag-scroll" scroll-x="true" show-scrollbar="false" scroll-with-animation>
					<view class="tag-row" :style="tagRowStyle">
						<view
							v-for="(item, index) in categoryTabs"
							:key="item.id != null ? item.id : 'all'"
							:class="['tag-item', index === activeCategoryIndex ? 'tag-item--active' : '']"
							@click="handleCategoryChange(index)"
						>
							<text class="tag-text">{{ item.label }}</text>
							<view v-if="index === activeCategoryIndex" class="tag-indicator"></view>
						</view>
					</view>
				</scroll-view>
				<!-- #endif -->

				<!-- #ifdef H5 -->
				<view class="sort-scroll sort-scroll-h5">
					<view class="sort-row">
						<view
							v-for="(item, index) in sortTabs"
							:key="item.label"
							:class="['sort-item', index === activeSortIndex ? 'sort-item--active' : '']"
							@click="handleSortChange(index)"
						>
							<text class="sort-text">{{ item.label }}</text>
						</view>
					</view>
				</view>
				<!-- #endif -->
				<!-- #ifndef H5 -->
				<scroll-view class="sort-scroll" scroll-x="true" show-scrollbar="false" scroll-with-animation>
					<view class="sort-row" :style="sortRowStyle">
						<view
							v-for="(item, index) in sortTabs"
							:key="item.label"
							:class="['sort-item', index === activeSortIndex ? 'sort-item--active' : '']"
							@click="handleSortChange(index)"
						>
							<text class="sort-text">{{ item.label }}</text>
						</view>
					</view>
				</scroll-view>
				<!-- #endif -->
			</view>
		</view>

		<scroll-view class="page-body" scroll-y="true" style="flex:1" :scroll-top="pageBodyScrollTop" @scrolltolower="handleScrollLower" lower-threshold="80">
			<view class="video-wrap">
				<view v-if="courseList.length > 0" class="course-section">
					<text class="section-title">相关课程</text>
					<view class="course-grid">
						<view v-for="c in courseList" :key="c.id" class="course-card" @click="navToCourse(c.id)">
							<image class="course-cover" :src="coverUrl(c.cover)" mode="aspectFill"></image>
							<view class="course-content">
								<text class="course-title">{{ c.title }}</text>
								<view class="course-meta">
									<view class="course-meta-item">
										<image class="meta-icon" src="/static/icons/iconify/play-fill.svg" mode="aspectFit"></image>
										<text class="course-meta-text">{{ safeNumber(c.playCount) }}</text>
									</view>
									<view class="course-meta-item">
										<image class="meta-icon" src="/static/icons/iconify/thumb-up-fill.svg" mode="aspectFit"></image>
										<text class="course-meta-text">{{ safeNumber(c.likeCount) }}</text>
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>
				<view class="video-section">
					<view v-if="loading && !isAppending" class="loading-wrap">
						<text class="loading-text">加载中...</text>
					</view>
					<view v-else-if="displayVideos.length === 0" class="empty-wrap">
						<text class="empty-text">暂无视频</text>
					</view>
					<view v-else class="video-grid">
						<view
							v-for="item in displayVideos"
							:key="item.id"
							class="video-card"
							@click="navToVideo(item.id)"
						>
							<image class="video-cover" :src="coverUrl(item.cover)" mode="aspectFill"></image>
							<view class="video-content">
								<text class="video-title">{{ item.title }}</text>
								<text class="video-course">{{ item.courseName ?? '课程' }}</text>
								<view class="video-meta">
								<view class="video-meta-item">
									<image class="meta-icon" src="/static/icons/iconify/play-fill.svg" mode="aspectFit"></image>
									<text class="video-meta-text">{{ safeNumber(item.playCount) }}</text>
								</view>
								<view class="video-meta-item">
									<image class="meta-icon" src="/static/icons/iconify/thumb-up-fill.svg" mode="aspectFit"></image>
									<text class="video-meta-text">{{ safeNumber(item.likeCount) }}</text>
								</view>
							</view>
							</view>
						</view>
					</view>
					<view v-if="displayVideos.length > 0" class="load-more">
						<text v-if="loadMoreStatus === 'loading'">加载中...</text>
						<text v-else-if="loadMoreStatus === 'no-more'">没有更多了</text>
						<text v-else>上拉加载更多</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 自定义 TabBar -->
		<custom-tab-bar :current="0" @change="handleTabChange"></custom-tab-bar>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref, nextTick } from 'vue'
	import { getVideoPage, type Video } from '../../api/video'
	import { getCoursePage, type Course } from '../../api/course'
	import { getEffectiveTags, type Tag } from '../../api/tag'
	import { getThemeRootStyle } from '../../utils/theme'
	import CustomTabBar from '../../components/custom-tab-bar.uvue'

	type CategoryTab = {
		id: number | null;
		label: string;
	}

	type SortTab = {
		label: string;
		value: string;
	}

	const categoryTabs = ref<CategoryTab[]>([{ id: null, label: '全部' }])
	const sortTabs: SortTab[] = [
		{ label: '综合排序', value: 'default' },
		{ label: '最新发布', value: 'latest' },
		{ label: '最多播放', value: 'play' },
		{ label: '最多点赞', value: 'like' },
		{ label: '最多评论', value: 'comment' }
	]

	const activeCategoryIndex = ref(0)
	const activeSortIndex = ref(0)
	const keyword = ref('')
	const loading = ref(false)
	const isAppending = ref(false)
	const loadMoreStatus = ref<'idle' | 'loading' | 'no-more'>('idle')
	const currentPage = ref(1)
	const pageSize = 12
	const videoList = ref<Video[]>([])
	const courseList = ref<Course[]>([])
	const courseLoading = ref(false)
	// 控制列表滚动位置：切换标签/排序时置顶，需先改值再设 0 才能生效
	const pageBodyScrollTop = ref(0)
	// 主题色：与后台配置同步，供本页 var(--brand-primary) 使用
	const themeRootStyle = computed(() => getThemeRootStyle())

	onShow(() => {
		refreshData()
	})

	async function refreshData(): Promise<void> {
		await loadTags()
		loadCourses()
		await loadVideos(false)
	}

	async function loadTags(): Promise<void> {
		const currentTab = categoryTabs.value.length > activeCategoryIndex.value ? categoryTabs.value[activeCategoryIndex.value] : null
		const currentId = currentTab != null ? currentTab.id : null
		try {
			const list = await getEffectiveTags()
			const tabs: CategoryTab[] = [{ id: null, label: '全部' }]
			if (Array.isArray(list)) {
				for (let i = 0; i < list.length; i++) {
					const item = list[i] as Tag
					if (item == null) continue
					const tid = item.id
					if (tid == null) continue
					const name = (item.name ?? '').trim()
					tabs.push({
						id: tid,
						label: name.length > 0 ? name : '未命名标签'
					})
				}
			}
			categoryTabs.value = tabs
			let nextIndex = 0
			if (currentId != null) {
				for (let i = 0; i < tabs.length; i++) {
					if (tabs[i].id === currentId) {
						nextIndex = i
						break
					}
				}
			}
			if (nextIndex >= tabs.length) {
				nextIndex = 0
			}
			activeCategoryIndex.value = nextIndex
		} catch (_e) {
			categoryTabs.value = [{ id: null, label: '全部' }]
			activeCategoryIndex.value = 0
		}
	}

	// 标签行宽度：保证横向滚动内容宽度超过容器，否则 scroll-x 不生效
	const tagRowStyle = computed((): Record<string, string> => {
		const count = categoryTabs.value.length
		const minWidth = count * 76 + 24
		return { width: minWidth + 'px' }
	})

	// 排序行宽度：综合排序/最新发布等 5 项不换行、可横向滚动
	const sortRowStyle = computed((): Record<string, string> => {
		const count = sortTabs.length
		const minWidth = count * 80 + 24
		return { width: minWidth + 'px' }
	})

	const selectedTagId = computed((): number | null => {
		const tabs = categoryTabs.value
		if (tabs.length === 0) return null
		const idx = activeCategoryIndex.value
		if (idx < 0 || idx >= tabs.length) return null
		return tabs[idx].id
	})

	function handleCategoryChange(index: number): void {
		if (index === activeCategoryIndex.value) return
		activeCategoryIndex.value = index
		currentPage.value = 1
		scrollBodyToTop()
		loadVideos(false)
	}

	function handleSortChange(index: number): void {
		if (index === activeSortIndex.value) return
		activeSortIndex.value = index
		currentPage.value = 1
		scrollBodyToTop()
		loadVideos(false)
	}

	function handleSearchInput(event: any): void {
		const value = typeof event.detail?.value === 'string' ? event.detail.value : ''
		keyword.value = value
	}

	function handleSearchConfirm(): void {
		currentPage.value = 1
		scrollBodyToTop()
		loadCourses()
		loadVideos(false)
	}

	function clearKeyword(): void {
		keyword.value = ''
		currentPage.value = 1
		scrollBodyToTop()
		loadCourses()
		loadVideos(false)
	}

	function scrollBodyToTop(): void {
		pageBodyScrollTop.value = 1
		nextTick(() => {
			pageBodyScrollTop.value = 0
		})
	}

	async function loadCourses(): Promise<void> {
		if (courseLoading.value) return
		courseLoading.value = true
		try {
			const params: { page: number; size: number; keyword?: string; tagId?: number } = { page: 1, size: 8 }
			const manualKeyword = keyword.value.trim()
			if (manualKeyword.length > 0) params.keyword = manualKeyword
			const tagId = selectedTagId.value
			if (tagId != null) params.tagId = tagId
			const res = await getCoursePage(params)
			courseList.value = res != null && Array.isArray(res.records) ? res.records : []
		} catch (_e) {
			courseList.value = []
		} finally {
			courseLoading.value = false
		}
	}

	async function loadVideos(append: boolean): Promise<void> {
		if (loading.value) return
		loading.value = true
		isAppending.value = append
		if (append) {
			loadMoreStatus.value = 'loading'
		} else {
			// 切换标签或排序：清空原数据，从第一页开始加载
			videoList.value = []
			currentPage.value = 1
			loadMoreStatus.value = 'idle'
		}
		try {
			const nextPage = append ? currentPage.value + 1 : 1
			const sortValue = sortTabs[activeSortIndex.value]?.value ?? 'default'
			const params: { page: number; size: number; keyword?: string; tagId?: number; sort?: string } = {
				page: nextPage,
				size: pageSize,
				sort: sortValue
			}
			const manualKeyword = keyword.value.trim()
			if (manualKeyword.length > 0) {
				params.keyword = manualKeyword
			}
			// 全部：不传 tagId，接口返回用户有效标签下所有视频
			const tagId = selectedTagId.value
			if (tagId != null) {
				params.tagId = tagId
			}
			const res = await getVideoPage(params)
			const list = res != null && Array.isArray(res.records) ? res.records : []
			if (append) {
				if (list.length > 0) {
					videoList.value = videoList.value.concat(list)
				}
			} else {
				videoList.value = list
			}
			const total = res != null && res.total != null ? res.total : videoList.value.length
			const current = res != null && res.current != null ? res.current : nextPage
			const size = res != null && res.size != null ? res.size : pageSize
			const totalPages = res != null && res.pages != null ? res.pages : (size > 0 ? Math.ceil(total / size) : 0)
			currentPage.value = current
			if ((!append && videoList.value.length === 0) || totalPages <= current || list.length === 0) {
				loadMoreStatus.value = 'no-more'
			} else {
				loadMoreStatus.value = 'idle'
			}
		} catch (_e) {
			if (!append) {
				videoList.value = []
				loadMoreStatus.value = 'no-more'
			} else {
				loadMoreStatus.value = 'idle'
			}
		} finally {
			loading.value = false
			isAppending.value = false
		}
	}

	// 直接使用接口返回顺序（接口已按 sort 参数排序）；两列展示由 video-grid 样式实现
	const displayVideos = computed((): Video[] => videoList.value)

	function coverUrl(cover: string | null | undefined): string {
		if (cover != null && cover.length > 0) {
			if (cover.startsWith('http')) return cover
			return '/api' + (cover.startsWith('/') ? cover : '/' + cover)
		}
		return '/static/logo.png'
	}

	function safeNumber(value: number | string | null | undefined): number {
		if (typeof value === 'number') return value
		if (typeof value === 'string' && value.length > 0) {
			const parsed = Number(value)
			return isNaN(parsed) ? 0 : parsed
		}
		return 0
	}

	function handleScrollLower(): void {
		if (loading.value || loadMoreStatus.value === 'no-more') return
		loadVideos(true)
	}

	function navToVideo(id: number): void {
		if (id != null && id > 0) {
			uni.navigateTo({ url: '/pages/video-player/video-player?id=' + id })
		}
	}

	function navToCourse(id: number): void {
		if (id != null && id > 0) {
			uni.navigateTo({ url: '/pages/course-detail/course-detail?id=' + id })
		}
	}

	function handleTabChange(index: number): void {
		// 处理 tab 切换事件
	}
</script>

<style>
.page {
	flex: 1;
	flex-direction: column;
	min-height: 100vh;
	background: var(--brand-gradient-immersive);
}
.page-header {
	flex-shrink: 0;
}
.page-body {
	flex: 1;
}
.video-wrap {
		padding: 0 12px 80px 12px;
	}
.container {
	flex-direction: column;
	padding: 10px 12px 8px 12px;
}
.search-bar {
	flex-direction: row;
	align-items: center;
	background-color: #ffffff;
	border-radius: 20px;
	padding: 8px 14px;
	margin-bottom: 8px;
	border-width: 1px;
	border-color: #ebeef5;
	border-style: solid;
}
.search-input {
	flex: 1;
	font-size: 14px;
	color: #323233;
}
.search-clear {
	font-size: 12px;
	color: #969799;
	margin-left: 12px;
}
.tag-scroll {
	background-color: transparent;
	margin-bottom: 6px;
	width: 100%;
	height: 38px;
}
.tag-row {
	display: flex;
	flex-direction: row;
	flex-wrap: nowrap;
	flex-shrink: 0;
	height: 38px;
	align-items: center;
}
/* H5：用 view + overflow-x 实现横向滚动；flex 行布局使子项按内容宽度收缩；隐藏滚动条 */
.tag-scroll-h5 {
	display: flex;
	flex-direction: row;
	overflow-x: auto;
	overflow-y: hidden;
	scrollbar-width: none;
	-ms-overflow-style: none;
}
.tag-scroll-h5::-webkit-scrollbar {
	display: none;
}
.tag-scroll-h5 .tag-row {
	flex-shrink: 0;
}
.tag-item {
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 4px 12px 8px 12px;
	margin-right: 8px;
	white-space: nowrap;
	flex-shrink: 0;
	position: relative;
}
.tag-item--active .tag-text {
	color: var(--brand-primary);
	font-weight: 600;
}
.tag-text {
	font-size: 13px;
	color: #646566;
}
.tag-indicator {
	position: absolute;
	bottom: 2px;
	left: 17%;
	right: 17%;
	height: 2px;
	border-radius: 1px;
	background-color: var(--brand-primary);
}
.sort-scroll {
	background-color: #ffffff;
	border-radius: 20px;
	margin-bottom: 8px;
	height: 40px;
	border-width: 1px;
	border-color: rgba(0,0,0,0.06);
	border-style: solid;
}
.sort-row {
	flex-direction: row;
	flex-wrap: nowrap;
	flex-shrink: 0;
	height: 40px;
	align-items: center;
	padding: 0 6px;
	justify-content: space-around;
}
.sort-scroll-h5 {
	display: flex;
	flex-direction: row;
	overflow-x: auto;
	overflow-y: hidden;
	scrollbar-width: none;
	-ms-overflow-style: none;
}
.sort-scroll-h5::-webkit-scrollbar {
	display: none;
}
.sort-scroll-h5 .sort-row {
	flex-shrink: 0;
}
.sort-item {
	padding: 4px 12px;
	border-radius: 14px;
	flex-shrink: 0;
}
.sort-item--active {
	background-color: var(--brand-primary);
}
.sort-item--active .sort-text {
	color: #ffffff;
	font-weight: 600;
}
.sort-text {
	font-size: 13px;
	color: #646566;
	white-space: nowrap;
}
.course-section {
	margin-bottom: 16px;
}
.section-title {
	font-size: 15px;
	font-weight: 600;
	color: #323233;
	margin-bottom: 8px;
	padding-left: 4px;
	border-left-width: 3px;
	border-left-color: var(--brand-primary);
	border-left-style: solid;
}
.course-grid {
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
}
.course-card {
			background-color: #ffffff;
			border-radius: 10px;
			overflow: hidden;
			margin-bottom: 10px;
			width: 48%;
			flex-direction: column;
			border-width: 1px;
			border-color: #ebeef5;
			border-style: solid;
		}
		.course-cover {
			width: 100%;
			height: 100px;
			background-color: #e8eaed;
		}
		.course-content {
			flex: 1;
			flex-direction: column;
			padding: 8px 10px;
		}
		.course-title {
			font-size: 14px;
			font-weight: 500;
			color: #323233;
			margin-bottom: 6px;
		}
		.course-meta {
				flex-direction: row;
				align-items: center;
			}
			.course-meta-item {
				flex-direction: row;
				align-items: center;
				margin-right: 12px;
			}
			.course-meta-text {
				font-size: 12px;
				color: #969799;
				margin-left: 4px;
			}
.video-section {
	background-color: transparent;
}
.video-grid {
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
}
.video-card {
	background-color: #ffffff;
	border-radius: 10px;
	overflow: hidden;
	margin-bottom: 12px;
	width: 48%;
	flex-direction: column;
	border-width: 1px;
	border-color: #ebeef5;
	border-style: solid;
}
.video-cover {
	width: 100%;
	height: 120px;
	background-color: #e8eaed;
}
.video-content {
	flex: 1;
	flex-direction: column;
	padding: 10px;
}
.video-title {
	font-size: 15px;
	font-weight: 600;
	color: #323233;
	margin-bottom: 6px;
}
.video-course {
	font-size: 13px;
	color: #646566;
	margin-bottom: 8px;
}
.video-meta {
			flex-direction: row;
			align-items: center;
		}
		.video-meta-item {
			flex-direction: row;
			align-items: center;
			margin-right: 12px;
		}
		.video-meta-text {
			font-size: 12px;
			color: #969799;
			margin-left: 4px;
		}
		.meta-icon {
			width: 12px;
			height: 12px;
			tint-color: #969799;
		}
.load-more {
	padding: 16px 0;
	align-items: center;
	justify-content: center;
}
.loading-wrap {
	padding: 40px 0;
	align-items: center;
}
.loading-text {
	font-size: 14px;
	color: #969799;
}
.empty-wrap {
	padding: 60px 0;
	align-items: center;
}
.empty-text {
	font-size: 14px;
	color: #969799;
}
</style>
