<template>
	<view class="page" :style="themeRootStyle">
		<scroll-view scroll-y="true" style="flex:1">
			<view class="content">
				<view class="user-block" @click="handleUserClick">
					<image class="user-avatar" :src="avatarUrl" mode="aspectFill"></image>
					<view class="user-info">
						<text class="user-name">{{ displayName }}</text>
						<text class="user-desc">{{ userDesc }}</text>
					</view>
				</view>

				<view v-if="hasToken" class="stats-row">
					<view class="stat-item" @click="navTo('/pages/my-learning/my-learning')">
						<text class="stat-value">{{ personalStats.courseCount }}</text>
						<text class="stat-label">学习课程</text>
					</view>
					<view class="stat-item">
						<text class="stat-value">{{ personalStats.avgProgress }}%</text>
						<text class="stat-label">平均进度</text>
					</view>
					<view class="stat-item" @click="navTo('/pages/my-points/my-points')">
						<text class="stat-value">{{ personalStats.totalPoints }}</text>
						<text class="stat-label">积分</text>
					</view>
					<view class="stat-item" @click="navTo('/pages/my-certificates/my-certificates')">
						<text class="stat-value">{{ personalStats.certificateCount }}</text>
						<text class="stat-label">证书</text>
					</view>
					<view class="stat-item" @click="navTo('/pages/my-tasks/my-tasks')">
						<text class="stat-value">{{ personalStats.taskCompletedCount }}</text>
						<text class="stat-label">已完成</text>
					</view>
				</view>

				<view class="menu-section">
					<view
						v-for="item in mainMenus"
						:key="item.path"
						class="menu-item"
						@click="navTo(item.path)"
					>
						<image class="menu-icon" :src="item.icon" mode="aspectFit"></image>
						<text class="menu-text">{{ item.text }}</text>
					</view>
				</view>

				<view class="menu-section">
					<view
						v-for="item in secondaryMenus"
						:key="item.path"
						class="menu-item"
						@click="navTo(item.path)"
					>
						<image class="menu-icon" :src="item.icon" mode="aspectFit"></image>
						<text class="menu-text">{{ item.text }}</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 自定义 TabBar -->
		<custom-tab-bar :current="2" @change="handleTabChange"></custom-tab-bar>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { getUser, isLoggedIn } from '../../utils/auth'
	import { getThemeRootStyle } from '../../utils/theme'
	import { getWatchedCourses } from '../../api/learning'
	import { getMyTotal } from '../../api/point'
	import { getMyCertificates } from '../../api/userCertificate'
	import { getMyTasks } from '../../api/userTask'
	import CustomTabBar from '../../components/custom-tab-bar.uvue'

	type MenuItem = {
		text: string;
		icon: string;
		path: string;
	}

	const themeRootStyle = computed(() => getThemeRootStyle())
	const hasToken = ref(isLoggedIn())
	const user = ref<Record<string, any>>({})
	const personalStats = ref({
		courseCount: 0,
		avgProgress: 0,
		totalPoints: 0,
		certificateCount: 0,
		taskCompletedCount: 0
	})

	const mainMenus: MenuItem[] = [
		{ text: '我的学习', icon: '/static/icons/fontawesome/book-open.svg', path: '/pages/my-learning/my-learning' },
		{ text: '我点赞的视频', icon: '/static/icons/fontawesome/thumb-up.svg', path: '/pages/my-liked-videos/my-liked-videos' },
		{ text: '课程中心', icon: '/static/icons/fontawesome/book.svg', path: '/pages/courses/courses' },
		{ text: '考试中心', icon: '/static/icons/fontawesome/file-lines.svg', path: '/pages/exam-list/exam-list' },
		{ text: '我的积分', icon: '/static/icons/fontawesome/coins.svg', path: '/pages/my-points/my-points' },
		{ text: '我的证书', icon: '/static/icons/fontawesome/certificate.svg', path: '/pages/my-certificates/my-certificates' },
		{ text: '我的任务', icon: '/static/icons/fontawesome/list-check.svg', path: '/pages/my-tasks/my-tasks' }
	]

	const secondaryMenus: MenuItem[] = [
		{ text: '设置', icon: '/static/icons/fontawesome/gear.svg', path: '/pages/settings/settings' },
		{ text: '关于', icon: '/static/icons/fontawesome/circle-info.svg', path: '/pages/about/about' }
	]

	const displayName = computed(() => {
		if (!hasToken.value) return '学员'
		const u = user.value
		const name = (u['nickname'] ?? u['realName'] ?? u['username']) as string
		return name != null && name.length > 0 ? name : '学员'
	})

	const userDesc = computed(() => {
		if (!hasToken.value) return '点击登录'
		const role = user.value['role'] as string
		return role === 'admin' ? '管理员' : '学员'
	})

	const avatarUrl = computed(() => {
		const a = user.value['avatar'] as string
		if (a != null && a.length > 0) return a
		return '/static/logo.png'
	})

	onShow(() => {
		loadUser()
		if (hasToken.value) loadPersonalStats()
	})

	function loadUser(): void {
		hasToken.value = isLoggedIn()
		const u = getUser()
		user.value = u != null ? u : {}
	}

	async function loadPersonalStats(): Promise<void> {
		if (!hasToken.value) return
		try {
			const [watched, points, certs, tasks] = await Promise.all([
				getWatchedCourses().catch(() => []),
				getMyTotal().catch(() => 0),
				getMyCertificates().catch(() => []),
				getMyTasks().catch(() => [])
			])
			const list = Array.isArray(watched) ? watched : []
			const courseCount = list.length
			let avgProgress = 0
			if (courseCount > 0) {
				let sum = 0
				for (let i = 0; i < list.length; i++) {
					const item = list[i] as any
					sum = sum + (item.progress ?? 0)
				}
				avgProgress = Math.round(sum / courseCount)
			}
			const certList = Array.isArray(certs) ? certs : []
			const taskList = Array.isArray(tasks) ? tasks : []
			let taskCompletedCount = 0
			for (let i = 0; i < taskList.length; i++) {
				const t = taskList[i] as any
				const ut = t.userTask
				if (ut != null && ut.status === 1) taskCompletedCount++
			}
			personalStats.value = {
				courseCount: courseCount,
				avgProgress: avgProgress,
				totalPoints: typeof points === 'number' ? points : 0,
				certificateCount: certList.length,
				taskCompletedCount: taskCompletedCount
			}
		} catch (_e) {}
	}

	function handleUserClick(): void {
		if (!hasToken.value) {
			uni.navigateTo({ url: '/pages/login/login?redirect=' + encodeURIComponent('pages/my/my') })
			return
		}
		uni.navigateTo({ url: '/pages/profile/profile' })
	}

	function navTo(url: string): void {
		uni.navigateTo({ url: url })
	}

	function handleTabChange(index: number): void {
		// 处理 tab 切换事件
	}
</script>

<style>
.page {
	flex: 1;
	flex-direction: column;
	min-height: 100vh;
	background: var(--brand-gradient-immersive);
}
.content {
		flex-direction: column;
		padding: 20px 16px 80px 16px;
	}
.user-block {
	flex-direction: row;
	align-items: center;
	padding: 16px;
	background-color: #ffffff;
	border-radius: 12px;
	margin-bottom: 16px;
	border-width: 1px;
	border-color: rgba(0,0,0,0.04);
	border-style: solid;
}
.user-avatar {
	width: 60px;
	height: 60px;
	border-radius: 30px;
	background-color: #ebedf0;
}
.user-info {
	flex-direction: column;
	margin-left: 16px;
}
.user-name {
	font-size: 18px;
	font-weight: 600;
	color: #323233;
}
.user-desc {
	font-size: 14px;
	color: #969799;
	margin-top: 4px;
}
.stats-row {
	flex-direction: row;
	background-color: #ffffff;
	border-radius: 12px;
	padding: 16px 0;
	margin-bottom: 16px;
	border-width: 1px;
	border-color: rgba(0,0,0,0.04);
	border-style: solid;
}
.stat-item {
	flex: 1;
	flex-direction: column;
	align-items: center;
}
.stat-value {
	font-size: 18px;
	font-weight: 600;
	color: #323233;
}
.stat-label {
	font-size: 12px;
	color: #969799;
	margin-top: 4px;
}
.menu-section {
	flex-direction: column;
	background-color: #ffffff;
	border-radius: 12px;
	margin-bottom: 16px;
	overflow: hidden;
	border-width: 1px;
	border-color: rgba(0,0,0,0.04);
	border-style: solid;
}
.menu-item {
	flex-direction: row;
	align-items: center;
	padding: 14px 16px;
	border-bottom-width: 1px;
	border-bottom-color: #ebedf0;
}
.menu-icon {
	width: 24px;
	height: 24px;
	margin-right: 12px;
}
.menu-item:last-child {
	border-bottom-width: 0;
}
.menu-text {
	font-size: 16px;
	color: #323233;
}
</style>
