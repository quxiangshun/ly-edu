# ========== 复制为 .env 后按需修改 ==========
# 本地使用 Docker MySQL 时可不改（与 compose-mysql-redis.yml 一致）

# ---------- MySQL（主库，API 使用） ----------
# 注意：变量名为 MYSQL_USERNAME 不是 MYSQL_USER
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=lyedu123456
MYSQL_DATABASE=lyedu
MYSQL_CHARSET=utf8mb4

# ---------- Redis（若项目使用） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 飞书开放平台（登录与通讯录同步） ----------
# FEISHU_APP_ID=your_app_id
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_REDIRECT_URI=https://your-domain.com/login

# ---------- 微信小程序（手机号登录，需企业认证） ----------
# WECHAT_MP_APP_ID=your_mp_appid
# WECHAT_MP_APP_SECRET=your_mp_secret

# ---------- JWT ----------
# JWT_SECRET=your_secret
# JWT_EXPIRE=86400

# ---------- 服务 ----------
# HOST=0.0.0.0
# PORT=9700

# ---------- 上传 ----------
# UPLOAD_PATH=./uploads

# ---------- FA 同步脚本（sync_fa_to_ly.py） ----------
# 数据源（FA 库）
FA_SOURCE_HOST=127.0.0.1
FA_SOURCE_PORT=3307
FA_SOURCE_USER=root
FA_SOURCE_PASSWORD=root
FA_SOURCE_DATABASE=xjty

# 目标库（LyEdu，未设置时复用 MYSQL_*）
# FA_TARGET_HOST=
# FA_TARGET_PORT=
# FA_TARGET_USER=
# FA_TARGET_PASSWORD=
# FA_TARGET_DATABASE=
